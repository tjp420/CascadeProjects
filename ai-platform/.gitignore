# SimpleBeacon local vault — never commit licenses, reports, or subscription store
.simplebeacon/*
!.simplebeacon/config.json

# Enterprise license signing (public key may be added deliberately via tools/generate-enterprise-license-keys.js)
**/enterprise-license-private.pem
**/license-private.pem
**/simplebeacon-license.json
**/license.json

# Secrets / env
.env
.env.*
!.env.example*

# Dependencies and local caches
node_modules/
github-cache/
data-central/
data/.dev-jwt-secrets.json
data/.test-token.txt

# Build artifacts
dist/
build/
.next/
out/
coverage/

# Demo / fixture data (not production)
web/data/*-sample.json
web/data/phase-ai-*.json
web/data/complete-scan-report-*.json
web/data/roadmap-from-scan-*.json
web/data/roadmap-ai*-*.json
coming-soon/sample-report.html

# Runtime logs
*.log
logs/

# Published trust verification output (generated by npm run trust:publish)
public/

# Accidental files
p.id
backups/
auth-test-out.txt
auth-test-output.txt
*-test-out.txt
