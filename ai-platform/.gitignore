# Regenerable artifacts (also covered by repo-root .gitignore)
node_modules/
coverage/
temp/
assets/
archive/
src/web/web/
test-batch-data/
api/upload.js
htmlcov/
__pycache__/
*.pyc
*.log
.venv/
**/.venv/

# Local secrets
.env
.env.local
.env.production
.env.v1-internal

# Simplebeacon local scan cache (review before deleting)
.simplebeacon/analyzer-cache.json
.simplebeacon/archive/
github-cache/

# CI step log fragments (empty workflow captures — not source)
docs/*-stdout*.txt
docs/*-stderr*.txt

# Local GGUF model weights (upload via /api/models/upload — never commit)
data-central/ai-tools/ai-models/uploads/*.gguf
data-central/ai-tools/ai-models/uploads/**
!data-central/ai-tools/ai-models/uploads/.gitkeep
