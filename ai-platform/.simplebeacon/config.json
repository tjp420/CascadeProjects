{
  "profile": "eu-ai-act",
  "scanPaths": [
    "web/data",
    "tests/fixtures",
    "data"
  ],
  "productionPaths": [
    "server/",
    "src/"
  ],
  "sampleDir": "web/data",
  "consistencyAnchorSamples": [
    "dashboard-home-sample.json",
    "engineering-baseline-sample.json",
    "implementation-plan-sample.json",
    "master-roadmap-sample.json",
    "release-timeline-sample.json"
  ],
  "ignore": [
    "node_modules/**",
    "coverage/**",
    "dist/**",
    "build/**",
    "**/*.test.js",
    "**/*.spec.js",
    "**/*.test.ts",
    "**/*.spec.ts",
    "tests/**",
    "test/**",
    "**/.github-sync/**",
    "**/bin/**",
    "packages/simplebeacon-cli/**"
  ],
  "rules": {
    "credentials": {
      "enabled": true,
      "scanProduction": true
    },
    "json-schema": {
      "enabled": true
    },
    "sample-consistency": {
      "enabled": true
    },
    "roadmap": {
      "enabled": true
    },
    "production-leak": {
      "enabled": true,
      "severity": "high"
    },
    "fiction-kpi-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "llm-slop-patterns": {
      "enabled": true,
      "severity": "medium",
      "registryCheck": false
    },
    "agency-handoff-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "eu-ai-act-patterns": {
      "enabled": true,
      "severity": "medium",
      "ignoreGlobs": [
        "docs/**",
        "**/free-slop-audit-offer.md",
        "**/outreach-cc-campaign.md",
        "**/prospect-list.md"
      ]
    },
    "file-naming-patterns": {
      "enabled": false,
      "severity": "medium"
    },
    "jest-baseline": {
      "enabled": false,
      "runTests": false
    },
    "token-bleed-patterns": {
      "enabled": false,
      "severity": "medium"
    },
    "architecture-drift-patterns": {
      "enabled": false,
      "severity": "high"
    },
    "python-ast-patterns": {
      "enabled": false,
      "severity": "medium"
    },
    "javascript-ast-patterns": {
      "enabled": false,
      "severity": "medium"
    }
  },
  "gate": {
    "failOn": [
      "high"
    ],
    "warnOn": [
      "medium",
      "low"
    ]
  },
  "sourceCodeScanPaths": [
    "server/",
    "src/"
  ],
  "fullDirectoryScan": false,
  "fullDirectoryScanSkipDirs": [
    ".git",
    ".github-sync",
    "github-cache",
    "node_modules"
  ]
}
