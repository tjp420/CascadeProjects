{
  "profile": "cascade",
  "scanPaths": [
    "web/data",
    "tests/fixtures",
    "data"
  ],
  "productionPaths": [
    "server/",
    "src/",
    "app/",
    "lib/"
  ],
  "sampleDir": "web/data",
  "consistencyAnchorSamples": [
    "dashboard-home-sample.json",
    "engineering-baseline-sample.json",
    "implementation-plan-sample.json",
    "master-roadmap-sample.json",
    "release-timeline-sample.json"
  ],
  "rules": {
    "credentials": {
      "enabled": true,
      "scanProduction": true
    },
    "json-schema": {
      "enabled": true
    },
    "sample-consistency": {
      "enabled": true
    },
    "roadmap": {
      "enabled": true
    },
    "production-leak": {
      "enabled": true,
      "severity": "medium",
      "allowlistFiles": [
        "server/lib/snapshot-seeds.js",
        "server/lib/snapshot-resolver.js",
        "server/lib/sample-path-resolver.cjs",
        "server/lib/code-roadmap-generator.cjs",
        "server/services/model-inference-service.js"
      ],
      "productionPaths": [
        "server/",
        "src/",
        "app/",
        "lib/"
      ],
      "plainSampleJson": true,
      "intentClassification": true
    },
    "fiction-kpi-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "llm-slop-patterns": {
      "enabled": true,
      "severity": "medium",
      "registryCheck": false
    },
    "agency-handoff-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "eu-ai-act-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "jest-baseline": {
      "enabled": false,
      "runTests": false,
      "testCommand": "npm test -- --no-coverage --passWithNoTests"
    },
    "token-bleed-patterns": {
      "enabled": false,
      "severity": "medium"
    },
    "architecture-drift-patterns": {
      "enabled": false,
      "severity": "high"
    },
    "python-ast-patterns": {
      "enabled": false,
      "severity": "medium"
    },
    "javascript-ast-patterns": {
      "enabled": false,
      "severity": "medium"
    }
  },
  "gate": {
    "failOn": [
      "high"
    ],
    "warnOn": [
      "medium",
      "low"
    ]
  },
  "sourceCodeScanPaths": [
    "server/",
    "src/"
  ],
  "fullDirectoryScan": false,
  "fullDirectoryScanSkipDirs": [
    ".git",
    ".github-sync",
    "github-cache",
    "node_modules",
    "simplebeacon-rule-tests"
  ]
}
