{
  "name": "simplebeacon-local-agent",
  "version": "1.0.0",
  "description": "Local agent that lets the SimpleBeacon web dashboard scan local filesystem paths.",
  "main": "agent.cjs",
  "bin": {
    "simplebeacon-local-agent": "./agent.cjs"
  },
  "scripts": {
    "start": "node agent.cjs",
    "test": "node agent.test.cjs",
    "build": "node build.cjs",
    "build:portable": "node build-portable.cjs",
    "package": "npm run build && pkg package.json --out-path dist",
    "package:portable": "npm run build && npm run build:portable"
  },
  "pkg": {
    "scripts": [
      "agent.cjs",
      "../../packages/simplebeacon-cli/src/index.js",
      "../../packages/simplebeacon-cli/src/**/*.js",
      "../../packages/simplebeacon-cli/src/**/*.cjs"
    ],
    "assets": [
      "../../.simplebeacon/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-linux-x64"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "license": "MIT"
}
