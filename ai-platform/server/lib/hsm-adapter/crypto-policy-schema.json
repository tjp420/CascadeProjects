{
  "$schema": "https://schemas.simplebeacon.ai/crypto-policy/v1",
  "version": "1.1.0",
  "default": {
    "minimumKekBits": 128,
    "keyExpirationDays": 0,
    "allowEphemeralSecrets": false,
    "allowedAlgorithms": {
      "aes": {
        "kw": true,
        "kwp": true,
        "bits": [128, 192, 256]
      },
      "rsa": {
        "oaep": true,
        "minBits": 2048
      },
      "ecdh": {
        "curves": ["P-256", "P-384", "P-521"]
      }
    },
    "deprecatedAlgorithms": [],
    "eviction": {
      "inactivityEvictionSeconds": 0,
      "zeroizeStrategy": "random",
      "auditOnEvict": true
    }
  },
  "tenants": {}
}
