# Production environment — copy to ai-platform/.env.production (never commit secrets)

NODE_ENV=production
# v1-internal dashboard default; Docker SaaS stacks may use 8080 behind a reverse proxy
PORT=54355

# Auth (required for hosted dashboard)
REQUIRE_AUTH=true
JWT_SECRET=replace-with-64-char-random
JWT_REFRESH_SECRET=replace-with-64-char-random
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Public URL — Stripe redirects + email links
SIMPLEBEACON_APP_URL=https://simplebeacon.ai

# Landing at / ; dashboard at /app
SIMPLEBEACON_LANDING=true

# Do NOT set on public production unless internal operator preview
# SIMPLEBEACON_INTERNAL_DASHBOARD=true

# --- Week 1 payments (enable after Stripe keys + price IDs are live) ---
# Phase 1 auth-only deploy: leave false until STRIPE_SECRET_KEY + price_... IDs are set.
SIMPLEBEACON_MONETIZATION_ENABLED=false
STRIPE_SECRET_KEY=rk_live_or_sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create in Stripe Dashboard → Products → Prices (price_... IDs)
STRIPE_PRICE_ID_TEAMS_MONTHLY=price_...
STRIPE_PRICE_ID_TEAMS_ANNUAL=price_...
STRIPE_PRICE_ID_ENTERPRISE_SETUP=price_...
STRIPE_PRICE_ID_ENTERPRISE_RETAINER=price_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Optional bootstrap: STRIPE_SECRET_KEY=sk_test_... node tools/bootstrap-stripe-test-prices.js

SIMPLEBEACON_CALENDLY_URL=https://calendly.com/simplebeacon/compliance-audit
SIMPLEBEACON_FOUNDING_SLOTS=50
SIMPLEBEACON_FOUNDING_LAUNCH=true

# Infra (enable for production SaaS — solo v1-internal often runs with ENABLE_DATABASE=false)
ENABLE_DATABASE=true
ENABLE_REDIS=true
DATABASE_URL=postgresql://cascade_user:replace-me@postgres:5432/cascade_ai_platform
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cascade_ai_platform
DB_USER=cascade_user
DB_PASSWORD=replace-me
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=cascade:
REDIS_SNAPSHOT_TTL_SECONDS=300

# CORS — comma-separated production origins (required when NODE_ENV=production)
CORS_ORIGINS=https://simplebeacon.ai,https://www.simplebeacon.ai

SEED_DEMO_USERS=false
