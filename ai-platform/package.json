{
  "name": "simplebeacon-platform",
  "version": "1.0.0",
  "description": "Simplebeacon — AI safety scanning, dashboard, and audit APIs",
  "main": "server/index.cjs",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "simplebeacon": "node ../packages/simplebeacon-cli/bin/simplebeacon.js scan --path . --format json --output .simplebeacon/report.json --gate",
    "sb:hook:pre-commit": "node ../packages/simplebeacon-cli/bin/simplebeacon.js scan --path . --gate --fail-on high",
    "sb:hook:pre-push": "node ../packages/simplebeacon-cli/bin/simplebeacon.js scan --path . --gate --with-jest --fail-on high",
    "simplebeacon:full": "node ../packages/simplebeacon-cli/bin/simplebeacon.js scan --path . --format json --output .simplebeacon/report.json --gate --with-jest",
    "simplebeacon:path-check": "node tools/simplebeacon-path-check.js",
    "analyze:zscript-report": "node tools/generate-zscript-mod-report.js",
    "simplebeacon:report": "npm run simplebeacon",
    "simplebeacon:pre-pr": "node ../packages/simplebeacon-cli/bin/simplebeacon.js scan --path . --format json --output .simplebeacon/report.json --gate --offline && node ../packages/simplebeacon-cli/bin/simplebeacon.js gate status",
    "intelligence:fetch-grammars": "npm run fetch-grammars --workspace=@simplebeacon/intelligence",
    "intelligence:test": "npm test --workspace=@simplebeacon/intelligence && node --test packages/simplebeacon-cli/tests/intelligence-bridge.test.js packages/simplebeacon-cli/tests/structural-intent-patterns.test.js",
    "simplebeacon:hygiene-gate": "npm run intelligence:fetch-grammars && node ../packages/simplebeacon-cli/bin/simplebeacon.js scan --path . --format json --output .simplebeacon/report.json --gate --offline --verbose && node ../packages/simplebeacon-cli/bin/simplebeacon.js gate status",
    "trust:validate-env": "node tools/validate-trust-publish-env.js",
    "env:audit": "node ../packages/simplebeacon-cli/bin/simplebeacon.js reduce --path . --scanner environment-variables --format json --output .simplebeacon/env-audit.json",
    "trust:publish": "node tools/publish-trust-verification.js",
    "trust:refresh": "node tools/refresh-trust-snapshots.js",
    "trust:scan-monorepo": "node tools/scan-monorepo-report.js",
    "trust:ci-summary": "node tools/append-trust-step-summary.js",
    "trust:history": "node tools/trust-history-report.js",
    "trust:trend": "node tools/trust-history-report.js --trend",
    "optimization:scan": "node tools/optimization-scan.js",
    "data:archive": "node tools/archive-data-cleanup.js",
    "simplebeacon:comment": "node ../packages/simplebeacon-cli/bin/simplebeacon.js comment --report .simplebeacon/report.json",
    "simplebeacon:init": "node ../packages/simplebeacon-cli/bin/simplebeacon.js init",
    "dlp:start": "node server/enterprise-dlp.js",
    "dlp:test": "node --test server/test-gateway.js",
    "simplebeacon:baseline-sync": "node ../packages/simplebeacon-cli/bin/simplebeacon.js baseline sync",
    "simplebeacon:assess": "node ../packages/simplebeacon-cli/bin/simplebeacon.js assess --path . --report .simplebeacon/report.json",
    "simplebeacon:scan:expanded": "node ../packages/simplebeacon-cli/bin/simplebeacon.js scan --path . --format json --output .simplebeacon/report-expanded.json",
    "validate:json:all": "node tools/validate-all-json.js",
    "scan:kpi:source": "node tools/scan-source-kpi-patterns.js",
    "scan:kpi:source:docs": "node tools/scan-source-kpi-patterns.js --include-docs",
    "scan:kpi:source:code": "node tools/scan-source-kpi-patterns.js --source-scope",
    "scan:kpi:known-values": "rg -n \"74\\\\.17|98\\\\.5|94\\\\.3|\\\\b87\\\\b|\\\\b66\\\\b|\\\\b62\\\\b|\\\\b47\\\\b|\\\\b100\\\\b|\\\\b156\\\\b|\\\\b8\\\\b|\\\\b9\\\\b\" web/data server/lib web/api packages/simplebeacon-cli/src .simplebeacon",
    "scan:kpi:all": "npm run scan:kpi:source:code && npm run scan:kpi:source:docs && npm run scan:kpi:known-values",
    "guard:fiction-kpi": "node tools/fiction-kpi-guard.js --staged",
    "guard:fiction-kpi:strict": "node tools/fiction-kpi-guard.js --strict",
    "guard:fiction-kpi:ci": "node tools/fiction-kpi-guard.js --ci --paths web/data,server/lib,web/api,packages/simplebeacon-cli/src,docs/reports --report .simplebeacon/fiction-kpi-guard-report.json",
    "guard:debug-artifacts": "node tools/production-debug-guard.js --report .simplebeacon/debug-artifact-guard-report.json",
    "guard:debug-artifacts:strict": "node tools/production-debug-guard.js --strict --report .simplebeacon/debug-artifact-guard-report.json",
    "remediation:metrics": "node tools/remediation-weekly-metrics.js",
    "remediation:gate": "node tools/remediation-weekly-metrics.js --gate",
    "scan:fiction-remediation-map": "node tools/fiction-pattern-remediation-map.js --out .simplebeacon/fiction-pattern-remediation-map.json",
    "schema:coverage:extended": "node tools/extended-schema-coverage-check.js",
    "metrics:quality:build": "node tools/quality-maintenance-metrics.js",
    "metrics:jest:evidence": "node tools/jest-quality-evidence.js",
    "scan:credentials:repo": "node tools/scan-credential-patterns-repo.js",
    "scan:oversized": "node tools/list-oversized-files.js --threshold-kb=250",
    "compliance:audit-baseline": "node tools/validate-audit-baseline.js",
    "quality-security:weekly-review": "npm run simplebeacon:report && npm run simplebeacon:assess -- --output .simplebeacon/assessment.json && npm run schema:coverage:extended && npm run scan:kpi:source:code && npm run guard:debug-artifacts && npm test -- --no-coverage --json --outputFile .simplebeacon/jest-result.json --passWithNoTests && npm run metrics:jest:evidence && npm run metrics:quality:build && npm audit --audit-level=high && npm run compliance:check && npm run compliance:audit-baseline && npm run simplebeacon:report && npm run trust:publish",
    "scan:coverage:expanded": "npm run simplebeacon:scan:expanded && npm run validate:json:all && npm run scan:kpi:source && npm test -- --no-coverage --passWithNoTests",
    "scan:validation:full": "npm run simplebeacon:scan:expanded && npm run validate:json:all && npm run scan:kpi:all && npm run scan:credentials:repo && npm run test:integration && npm run smoke:test",
    "export-system:sync": "sh ../scripts/sync-export-system.sh",
    "export-system:check": "node tools/verify-export-system-shim.js",
    "security:scan": "npm run simplebeacon:report && npm run simplebeacon:assess -- --output .simplebeacon/assessment.json && npm run trust:publish",
    "compliance:check": "node ../packages/simplebeacon-cli/bin/simplebeacon.js compliance --path . --report .simplebeacon/report.json",
    "start": "node server/index.cjs",
    "dev": "nodemon server/index.js",
    "build": "node -c server/index.cjs && echo 'Server syntax OK'",
    "build:wasm": "cd web/simplebeacon-dashboard/wasm && wasm-pack build --target web --out-dir pkg",
    "fast": "node scripts/build-fast.js",
    "fast:simple": "node scripts/build-fast.js simple",
    "fast:express": "node scripts/build-fast.js express",
    "fast:webpack": "node scripts/build-fast.js webpack",
    "test": "jest --config jest.config.cjs",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:coverage:critical-path": "jest --config jest.critical-path.config.cjs --coverage",
    "test:server:lib": "node --test server/lib/__tests__/*.test.cjs",
    "coverage": "npm run test:coverage",
    "coverage:sync": "npm run test:coverage && node tools/sync-coverage-reports-sample.js",
    "verify:critical-path-coverage": "node tools/verify-critical-path-coverage.js",
    "verify:track2": "node tools/verify-track2-readiness.js",
    "verify:production-host-readiness": "node tools/verify-production-host-readiness.js",
    "verify:production-host-gate": "node tools/verify-production-host-gate.js",
    "sample:certificate": "node tools/generate-sample-certificate.js",
    "test:dashboard": "jest --config jest.config.cjs",
    "test:all": "jest",
    "dashboard": "node simplebeacon-server.cjs",
    "dashboard:stub": "node fixed-server.js",
    "phase2:infra": "docker compose -f docker-compose.phase2.yml up -d",
    "phase2:infra:down": "docker compose -f docker-compose.phase2.yml down",
    "simplebeacon:docker": "docker compose -f docker-compose.simplebeacon.yml up --build",
    "simplebeacon:docker:detached": "docker compose -f docker-compose.simplebeacon.yml up -d --build",
    "simplebeacon:docker:dev": "docker compose -f docker-compose.simplebeacon.yml -f docker-compose.simplebeacon.dev.yml up --build",
    "simplebeacon:docker:full": "docker compose -f docker-compose.simplebeacon.yml -f docker-compose.simplebeacon.full.yml --profile full up -d --build",
    "simplebeacon:docker:down": "docker compose -f docker-compose.simplebeacon.yml --profile full down",
    "simplebeacon:docker:config": "docker compose -f docker-compose.simplebeacon.yml -f docker-compose.simplebeacon.full.yml --profile full config",
    "simplebeacon:deploy": "bash scripts/deploy-simplebeacon.sh",
    "backup:database": "node scripts/backup-database.js",
    "dashboard:v1-internal": "node tools/start-v1-internal-dashboard.cjs",
    "dashboard:kill-ports": "node tools/kill-dashboard-ports.cjs",
    "models:restore": "node tools/restore-local-models.js",
    "staging:paywall": "node tools/start-v1-internal-dashboard.cjs",
    "auto:start": "node auto-processor.js",
    "auto:start:offline": "node auto-processor.js",
    "auto:start:pm2": "pm2 start auto-processor.js --name simplebeacon-automation",
    "auto:stop": "pm2 stop simplebeacon-automation",
    "auto:restart": "pm2 restart simplebeacon-automation",
    "auto:logs": "pm2 logs simplebeacon-automation",
    "build:sample-report": "node tools/build-sample-report.js",
    "upgrade-audit-html": "node tools/upgrade-legacy-audit-html.js",
    "verify:v1-internal": "jest --config jest.config.cjs --no-coverage tests/integration/phase2-integration.test.js",
    "verify:v1-internal-profile": "node tools/verify-v1-internal-profile.cjs",
    "verify:production-deploy": "node tools/verify-production-deploy-readiness.cjs",
    "verify:route-smoke": "node tools/run-route-smoke-suite.js",
    "smoke:test": "node tools/run-route-smoke-suite.js",
    "smoke:test:production": "node tools/run-route-smoke-suite.js --production",
    "smoke:test:marketing": "node tools/run-route-smoke-suite.js --production --marketing",
    "verify:launch-readiness": "node tools/verify-launch-readiness.js",
    "test:integration": "jest --config jest.config.cjs --no-coverage tests/integration",
    "test:api": "jest --config jest.config.cjs --no-coverage tests/integration/simplebeacon-api.test.js tests/integration/ai-validation-api.test.js tests/integration/local-models-api.test.js tests/integration/dashboard-api.test.js",
    "test:auth": "jest --config jest.config.cjs --no-coverage tests/integration/phase2-integration.test.js tests/integration/simplebeacon-monetization.test.js",
    "test:export": "jest --config jest.config.cjs --no-coverage tests/e2e/dashboard-pages.e2e.test.js tests/e2e/simplebeacon-dashboard.e2e.test.js",
    "verify:stripe": "node tools/verify-stripe-config.js",
    "verify:predeploy": "node tools/verify-predeploy-sequence.js",
    "bundle:signin-site": "node tools/create-signed-off-site-bundle.js",
    "bundle:signin-site:links": "node tools/create-signed-off-site-bundle.js --links-only",
    "deploy:v1-internal": "node tools/start-v1-internal-dashboard.cjs",
    "lint": "node tools/run-eslint.cjs",
    "lint:fix": "node tools/run-eslint.cjs --fix",
    "postinstall": "node tools/verify-eslint-deps.js",
    "quality:check": "npm run lint && npm run simplebeacon:report && npm run compliance:check",
    "format": "npx prettier --write \"server/**/*.cjs\"",
    "clean": "rm -rf node_modules dist coverage",
    "deploy": "npm run build && npm run test"
  },
  "keywords": [
    "ai",
    "platform",
    "cascade",
    "automation",
    "analysis"
  ],
  "author": "Cascade AI Platform Team",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "chokidar": "^3.5.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.0.0",
    "http-errors": "^2.0.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.21.0",
    "redis": "^4.7.1",
    "simple-git": "^3.20.0",
    "speakeasy": "^2.0.0",
    "stripe": "^22.1.1",
    "tmp": "^0.2.7",
    "unzipper": "^0.12.3",
    "winston": "^3.8.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^15.14.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
