{
  "templateType": "executive-summary",
  "name": "Executive Summary Template",
  "version": "1.0",
  "description": "Template for generating executive summary reports",
  "sections": [
    {
      "id": "overview",
      "title": "Project Overview",
      "type": "metrics",
      "required": true,
      "fields": [
        "totalFeatures",
        "completedFeatures",
        "completionRate",
        "projectHealth",
        "developmentVelocity",
        "aiConfidence"
      ]
    },
    {
      "id": "keyMetrics",
      "title": "Key Performance Indicators",
      "type": "charts",
      "required": true,
      "charts": [
        "completionRateChart",
        "velocityTrendChart",
        "qualityMetricsChart"
      ]
    },
    {
      "id": "insights",
      "title": "Executive Insights",
      "type": "text",
      "required": true,
      "fields": [
        "projectHealth",
        "riskAssessment",
        "recommendations"
      ]
    }
  ],
  "styling": {
    "theme": "executive",
    "colors": {
      "primary": "#6366f1",
      "success": "#10b981",
      "warning": "#f59e0b",
      "danger": "#ef4444"
    },
    "layout": "professional"
  },
  "exportFormats": ["json", "pdf", "excel"],
  "createdAt": "2026-05-22T00:00:00.000Z",
  "updatedAt": "2026-05-22T00:00:00.000Z"
}
