{
  "dashboard": {
    "title": "Advanced Analytics Dashboard",
    "version": "2.0.0",
    "theme": {
      "default": "light",
      "available": ["light", "dark", "auto"],
      "transitions": true
    },
    "layout": {
      "sidebar": {
        "enabled": true,
        "collapsible": true,
        "defaultWidth": 250
      },
      "header": {
        "enabled": true,
        "showUser": true,
        "showNotifications": true
      },
      "tabs": {
        "default": "overview",
        "available": ["overview", "analysis", "predictions", "exports", "directory"],
        "rememberLast": true
      }
    },
    "features": {
      "realTimeUpdates": true,
      "autoRefresh": {
        "enabled": true,
        "interval": 5000
      },
      "caching": {
        "enabled": true,
        "ttl": 300000
      },
      "export": {
        "formats": ["json", "csv", "pdf"],
        "defaultFormat": "json"
      },
      "charts": {
        "animations": true,
        "responsive": true,
        "defaultType": "line"
      }
    },
    "performance": {
      "lazyLoading": true,
      "bundleSplitting": true,
      "compression": true,
      "caching": {
        "static": true,
        "api": true,
        "charts": true
      }
    },
    "accessibility": {
      "enabled": true,
      "keyboardNavigation": true,
      "screenReaderSupport": true,
      "highContrastMode": false,
      "reducedMotion": false,
      "fontSize": "normal",
      "focusVisible": true
    },
    "notifications": {
      "enabled": true,
      "position": "top-right",
      "duration": 5000,
      "maxVisible": 3,
      "sound": false
    },
    "debug": {
      "enabled": false,
      "console": true,
      "performance": false,
      "network": false
    }
  }
}
