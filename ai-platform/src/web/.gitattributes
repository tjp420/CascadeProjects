# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf

# The above will handle all files NOT found below
# These files are text and should be normalized (Convert CRLF to LF)
*.gitattributes text eol=lf
*.gitignore text eol=lf
*.editorconfig text eol=lf
*.eslintrc* text eol=lf
*.prettierrc* text eol=lf
*.babelrc* text eol=lf
*.npmrc text eol=lf
*.nvmrc text eol=lf
*.env* text eol=lf
*.config text eol=lf
*.config.js text eol=lf
*.config.json text eol=lf
*.config.ts text eol=lf
*.config.jsx text eol=lf
*.config.tsx text eol=lf

# These files are binary and should be left untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svgz binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.tar.gz binary
*.rar binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Denote all files that are truly binary and should not be modified.
*.psd binary
*.ai binary
*.eps binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Large files
*.mp4 binary
*.avi binary
*.mov binary
*.wmv binary
*.flv binary
*.webm binary
*.mp3 binary
*.wav binary
*.flac binary
*.ogg binary
*.aac binary

# Database files
*.db binary
*.sqlite binary
*.sqlite3 binary

# Lock files (should be left as-is)
package-lock.json binary
yarn.lock binary
pnpm-lock.yaml binary

# Logs
*.log binary

# Generated files
coverage/ binary
dist/ binary
build/ binary
node_modules/ binary
.npm/ binary
.cache/ binary
