# v1.0-internal profile — copy to .env.v1-internal and replace secrets before deploy.
# Usage: npm run dashboard:v1-internal

NODE_ENV=production
PORT=54355
# Match SIMPLEBEACON_APP_URL / dashboard origin when calling APIs from another host
CORS_ORIGIN=http://localhost:54355

# Required for shared/internal hosts
REQUIRE_AUTH=true
JWT_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

# Local dev only — npm run dashboard:v1-internal auto-enables this when JWT values are still placeholders
# ALLOW_DEV_EPHEMERAL_SECRETS=true

# Demo login works from server/db/demo-users.json when DB is disabled
ENABLE_DATABASE=false
ENABLE_REDIS=false
SEED_DEMO_USERS=true

# Verbose JWT auth logging (default off — SPA loads fire dozens of /api calls)
# LOG_AUTH=true

# Assessment API — auto-delete assessments/ artifacts after N hours (default 24)
ASSESSMENT_TTL_HOURS=24
ASSESSMENT_RETENTION_ENABLED=true
ALLOW_LEGACY_LOGIN=false

# Public URL (production: https://simplebeacon.ai)
SIMPLEBEACON_APP_URL=http://localhost:54355

# Landing at / ; dashboard at /app (uses ../coming-soon/)
SIMPLEBEACON_LANDING=true

# Internal operator preview only — never enable on simplebeacon.ai production
SIMPLEBEACON_INTERNAL_DASHBOARD=true

# Local vault gate — required when SIMPLEBEACON_INTERNAL_DASHBOARD=true
# DASHBOARD_VAULT_PASSWORD=replace-with-strong-local-password

# Stripe Cloud Teams + Enterprise — set keys to auto-enable monetization
# SIMPLEBEACON_MONETIZATION_ENABLED=true
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Cloud Teams ($49/mo) — use Stripe Price ID (price_...), not Product ID (prod_...)
# STRIPE_PRICE_ID_TEAMS_MONTHLY=price_...
# STRIPE_PRICE_ID_TEAMS_ANNUAL=price_...
# Enterprise Perimeter setup ($5,000 one-time) + optional retainer ($2,500/mo)
# STRIPE_PRICE_ID_ENTERPRISE_SETUP=price_...
# STRIPE_PRICE_ID_ENTERPRISE_RETAINER=price_...
# Legacy alias (maps to Cloud Teams monthly)
# STRIPE_PRICE_ID=price_...
# SIMPLEBEACON_BYPASS_EMAIL=dev@simplebeacon.ai
# Optional — live Calendly for Enterprise discovery (omit until URL works; mailto fallback used)
# SIMPLEBEACON_CALENDLY_URL=https://calendly.com/your-org/compliance-audit

# Audit booking form — sends to your inbox via Resend (https://resend.com)
# RESEND_API_KEY=re_...
# AUDIT_NOTIFY_TO=trevor_punt@live.com
# AUDIT_NOTIFY_FROM=SimpleBeacon <onboarding@resend.dev>
# After verifying simplebeacon.ai in Resend, use:
# AUDIT_NOTIFY_FROM=SimpleBeacon <noreply@simplebeacon.ai>
# SIMPLEBEACON_FOUNDING_SLOTS=50
# SIMPLEBEACON_FOUNDING_LAUNCH=true

# Stripe uses Price IDs (price_...), NOT Product IDs (prod_...) from the dashboard plan doc.

# Optional — AI narrative on Analyze (Ollama provider)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

ENABLE_GGUF_ISSUES_API=true

# Dashboard runtime (gguf-dashboard-server.js)
DEBUG_LOGS=false
EXPRESS_JSON_LIMIT=50mb
LOG_RUNTIME_INFO=false
RUNTIME_DEBUG=false
UPLOAD_TEST_URL=http://127.0.0.1:54355

# Analyze API path allowlist — optional override (defaults include ai-platform + monorepo parent)
# ANALYZE_ALLOWED_ROOTS=C:\Users\Trevor\CascadeProjects;C:\Users\Trevor\CascadeProjects\ai-platform;E:\Ai
# LOG_ANALYZE_PATH_ACCESS=true

# Auth rate limits
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=15
AUTH_REFRESH_RATE_LIMIT_MAX=30

# Audit logging
AUDIT_LEVEL=info
AUDIT_LOG_FILE=logs/audit.log

# SSO optional keys (disabled by default on internal dashboard)
GOOGLE_HOSTED_DOMAIN=
OKTA_CALLBACK_URL=
OKTA_ENTRY_POINT=
OKTA_AUDIENCE=
LDAP_GROUP_SEARCH_FILTER=(member={{userdn}})
LDAP_TIMEOUT=5000
LDAP_CONNECT_TIMEOUT=10000

# Database pool (when ENABLE_DATABASE=true)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=2000
