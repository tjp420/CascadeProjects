# Server Configuration — canonical environment template for ai-platform
# Copy to .env and adjust locally without changing this template.
#
# Environment file map:
#   .env.example              — full local/dev template (this file)
#   .env.production.example   — production deploy overlay
#   .env.v1-internal.example  — v1 dashboard profile (port 54355)
#   config/README.md          — legacy config folder (deprecated)
#
# Port matrix (avoid mixing these up):
#   PORT=3000  — legacy API entry (server/index.js, npm run server)
#   PORT=54355 — v1-internal Simplebeacon dashboard (gguf-dashboard-server.js)
#                Use .env.v1-internal + npm run dashboard:v1-internal
#                See docs/v1-internal-runbook.md
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# CORS Configuration (match PORT for the server you start)
CORS_ORIGIN=http://localhost:3000
# Production multi-origin list (server/lib/cors-config.js; overrides CORS_ORIGIN when set)
CORS_ORIGINS=

# Database Configuration
DATABASE_URL=postgresql://user:pass@localhost/cascade_platform

# Security Configuration
# Required when REQUIRE_AUTH=true or NODE_ENV=production (generate each with):
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=30d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
API_KEY=your-api-key-here

# External Services
# Set your Stripe test key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_dummy_key_for_development
STRIPE_WEBHOOK_SECRET=whsec_dummy_webhook_secret

# Logging Configuration
LOG_LEVEL=info
LOG_AUTH=false
AUTH_DEBUG=false
AUDIT_LEVEL=info
AUDIT_LOG_FILE=logs/audit.log
AUDIT_AUTH_LOGS=false

# Phase 2 — Data Integration
ENABLE_DATABASE=false
ENABLE_DB_AUTO_MIGRATE=true
SEED_DASHBOARD_SNAPSHOTS=true
SEED_DEMO_USERS=true
REQUIRE_AUTH=false
ALLOW_LEGACY_LOGIN=false
ENABLE_GGUF_ISSUES_API=true
ENABLE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=
REDIS_KEY_PREFIX=cascade:
REDIS_SNAPSHOT_TTL_SECONDS=300
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder
OLLAMA_TIMEOUT_MS=120000

# Local model restore (npm run models:restore → tools/restore-local-models.js)
# RESTORE_GGUF_PATH defaults to a GGUF under %USERPROFILE%\.ollama\... when unset (USERPROFILE is OS-provided)
RESTORE_GGUF_PATH=
RESTORE_OLLAMA_MODEL=unbreakable-oracle:latest

# Analyze API — allowed filesystem roots for /api/analyze/* and scan projectPath (semicolon-separated absolute paths).
# Auto-detect usually covers ai-platform + monorepo parent; uncomment to pin roots on this machine:
ANALYZE_ALLOWED_ROOTS=C:\Users\Trevor\CascadeProjects;C:\Users\Trevor\CascadeProjects\ai-platform;E:\Ai
LOG_ANALYZE_PATH_ACCESS=false

# Cloud AI providers (optional — used by /api/analyze/flexible for scan summaries)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
LOCAL_MODELS_DIR=
MAX_GGUF_UPLOAD_BYTES=8589934592
LLAMA_CPP_BIN=
LLAMA_CPP_MAX_TOKENS=512
LLAMA_CPP_TIMEOUT_MS=45000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cascade_ai_platform
DB_USER=cascade_user
# Required when ENABLE_DATABASE=true (no default — server throws if missing)
DB_PASSWORD=your-db-password-here
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=2000
LOG_QUERIES=false

# SSO Provider Configuration
AZURE_AD_ENABLED=false
AZURE_AD_CLIENT_ID=your_azure_client_id
AZURE_AD_CLIENT_SECRET=your_azure_client_secret
AZURE_AD_TENANT_ID=your_azure_tenant_id
AZURE_AD_RESOURCE=https://graph.microsoft.com
AZURE_AD_REDIRECT_URI=http://localhost:3000/auth/azure/callback

GOOGLE_SSO_ENABLED=false
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DOMAIN=your_company.com
GOOGLE_HOSTED_DOMAIN=your_company.com
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

OKTA_ENABLED=false
OKTA_CLIENT_ID=your_okta_client_id
OKTA_CLIENT_SECRET=your_okta_client_secret
OKTA_ISSUER=https://your_company.okta.com/oauth2/default
OKTA_ORG_URL=https://your_company.okta.com
OKTA_CALLBACK_URL=http://localhost:3000/auth/okta/callback
OKTA_ENTRY_POINT=https://your_company.okta.com/app/your_app/sso/saml
OKTA_AUDIENCE=http://localhost:3000
OKTA_CERTIFICATE=your_okta_certificate

LDAP_ENABLED=false
LDAP_URL=ldap://ldap.your_company.com:389
LDAP_BIND_DN=cn=admin,dc=your_company,dc=com
LDAP_BIND_CREDENTIALS=your_ldap_password
LDAP_SEARCH_BASE=ou=users,dc=your_company,dc=com
LDAP_SEARCH_FILTER=(uid={{username}})
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=your_company,dc=com
LDAP_GROUP_SEARCH_FILTER=(member={{userdn}})
LDAP_TIMEOUT=5000
LDAP_CONNECT_TIMEOUT=10000
LDAP_TLS_REJECT_UNAUTHORIZED=true

SAML_ENABLED=false
SAML_ENTRY_POINT=https://your_idp.com/saml
SAML_ISSUER=http://localhost:3000
SAML_CALLBACK_URL=http://localhost:3000/auth/saml/callback
SAML_CERTIFICATE=your_saml_certificate
SAML_PRIVATE_KEY=your_saml_private_key
SAML_SIGNATURE_ALGORITHM=sha256
SAML_DIGEST_ALGORITHM=sha256

# Base URLs
BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
REACT_APP_URL=http://localhost:3000
EMAIL_FROM=noreply@simplebeacon.ai

# Auth rate limits (server/bootstrap/phase2-integration.js)
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=15
AUTH_REFRESH_RATE_LIMIT_MAX=30

# DLP dashboard (server/enterprise-dlp.js, server/dlp-dashboard.js)
DASHBOARD_PORT=3000

# GGUF Dashboard local runbook (gguf-dashboard-server.js — fixed port 54355)
# Start:  ALLOW_DEV_EPHEMERAL_SECRETS=true node gguf-dashboard-server.js
ALLOW_DEV_EPHEMERAL_SECRETS=false
# Pages:  http://127.0.0.1:54355/dashboard.html  |  http://127.0.0.1:54355/code-upload.html
# Smoke:  node scripts/verify-upload-e2e.js
# Upload flow: code-upload.html → POST /api/upload/files → dashboard analysis buttons
# When REQUIRE_AUTH=true set JWT_SECRET and JWT_REFRESH_SECRET (see Security Configuration above)

# Enhanced Audit Configuration
AUDIT_BLOCKCHAIN=false
AUDIT_SIEM=false
AUDIT_SIEM_ENDPOINT=https://your-siem-endpoint.com/api/logs
AUDIT_SIEM_API_KEY=your_siem_api_key
AUDIT_FRAMEWORKS=SOC2,ISO27001,GDPR
AUDIT_REALTIME=true
AUDIT_ENCRYPTION=true

# Runtime/debug toggles (optional — referenced in server and CLI code)
DEBUG_LOGS=false
EXPRESS_JSON_LIMIT=50mb
LOG_RUNTIME_INFO=false
RUNTIME_DEBUG=false

# Simplebeacon CLI proxy (packages/simplebeacon-cli/src/proxy/gateway.js)
SIMPLEBEACON_PROXY_PORT=8787
SIMPLEBEACON_PROXY_UPSTREAM=
SIMPLEBEACON_PROXY_MAX_BODY=8388608

# Upload verification (scripts/verify-upload-e2e.js)
UPLOAD_TEST_URL=http://127.0.0.1:54355

# AI proxy / DLP gateway (optional enterprise modules)
PROXY_PORT=8080
VIOLATION_LOG_PATH=./ai-violations.log
BLOCK_ON_MATCH=true
ALERT_WEBHOOK=

# API debug toggles
API_OPT_DEBUG=false

# Codebase / data-quality scan tunables (server/lib/codebase-analyzer.js, simplebeacon-cli)
SCAN_PROFILE=data-quality
CODEBASE_ANALYZE_CONCURRENCY=4
CODEBASE_COMPLETE_CONCURRENCY=2
CODEBASE_COMPLETE_MAX_FILES=5000
CODEBASE_COMPLETE_MAX_FINDINGS=500
CODEBASE_DASHBOARD_MAX_FILES=2000
DATA_CLEANUP_SCAN_CACHE_TTL_MS=300000
FICTION_GUARD_STRICT=false

# Ollama integrations
OLLAMA_TAGS_CACHE_TTL_MS=300000
OLLAMA_TEST_TIMEOUT_MS=30000

# Upload pipeline (server middleware)
UPLOAD_ALLOWED_TYPES=.gguf,.json,.txt,.md
UPLOAD_MAX_SIZE=8589934592
UPLOAD_MAX_CONCURRENT=3
UPLOAD_CLEANUP_INTERVAL=3600000
UPLOAD_TEMP_DIR=uploads/temp

# Trust publish / Simplebeacon product flags
TRUST_PUBLISH_REQUIRED=false
TRUST_PUBLISH_STRICT=false
TRUST_PUBLISH_REQUIRE_TOKEN=false
TRUST_PUBLISH_ALLOW_HTTP=false
TRUST_PUBLISH_ENDPOINT=
TRUST_PUBLISH_TOKEN=
TRUST_HISTORY_MAX=100
SIMPLEBEACON_PUBLIC_GATE=false
SIMPLEBEACON_CLOSED_VAULT=false
SIMPLEBEACON_CONTEXT_WATCH_LOG=false
SIMPLEBEACON_DASHBOARD_TOKEN=
SIMPLEBEACON_KEY_ENCRYPTION_SECRET=
SIMPLEBEACON_SUBSCRIPTION_STORE=memory
SIMPLEBEACON_USER_AI_KEYS_STORE=memory
SIMPLEBEACON_TRUST_PUBLISH_URL=
SIMPLEBEACON_TRUST_PUBLISH_TOKEN=
SIMPLEBEACON_AUDIT_CHECKOUT_URL=
SIMPLEBEACON_PRO_PRICE_ID=
SIMPLEBEACON_ANNUAL_PROMOTION_ID=
SIMPLEBEACON_ENTERPRISE_SETUP_ID=
SIMPLEBEACON_ENTERPRISE_RETAINER_ID=
STRIPE_ANNUAL_PRICE_ID=

# Organization / waitlist notifications
ORG_NAME=SimpleBeacon
WAITLIST_NOTIFY_FROM=SimpleBeacon <onboarding@resend.dev>
WAITLIST_NOTIFY_TO=
# Resend API (server/lib/audit-booking-mail.js, simplebeacon-server.js waitlist route)
RESEND_API_KEY=
# Audit booking notifications (falls back to WAITLIST_NOTIFY_TO when unset)
AUDIT_NOTIFY_TO=
# Dev-only subscription bypass (server/middleware/simplebeacon-subscription.js)
SIMPLEBEACON_BYPASS_EMAIL=

# SMTP (optional outbound mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Smoke / CI verification scripts
SMOKE_BASE_URL=http://127.0.0.1:54355
SMOKE_BEARER_TOKEN=
SMOKE_LOGIN_EMAIL=
SMOKE_LOGIN_PASSWORD=
SMOKE_REQUIRE_AUTH=false
# Optional vault cookie for tools/run-route-smoke-suite.js (falls back from DASHBOARD_VAULT_PASSWORD)
SMOKE_VAULT_PASSWORD=
RUN_LIVE_GATEWAY_TEST=false

# Jest coverage summary fixture (jest.config.js sets this default when unset)
JEST_COVERAGE_SUMMARY_PATH=tests/fixtures/jest-coverage-summary.json
