# --- Stripe / billing ---
# MANDATORY in production: validated by server/config/validate-env.cjs at boot.
# Missing/invalid keys cause process.exit(1) in production (warn-only in dev).
#   STRIPE_SECRET_KEY: must start with sk_ (sk_test_ for dev, sk_live_ for prod)
#   STRIPE_WEBHOOK_SECRET: must start with whsec_ (from `stripe listen` or Dashboard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# 3-tier price IDs (set in Stripe Dashboard — see config/stripe_product_catalog.json)
STRIPE_PRICE_ID_DEVELOPER_MONTHLY=
STRIPE_PRICE_ID_DEVELOPER_ANNUAL=
STRIPE_PRICE_ID_TEAM_PRO_MONTHLY=
STRIPE_PRICE_ID_TEAM_PRO_ANNUAL=
# Legacy price IDs (still accepted by webhook handler with legacy:true mapping)
STRIPE_PRICE_ID_STARTUP_MONTHLY=
SIMPLEBEACON_STARTUP_PRICE_ID=
STRIPE_PRICE_ID_STARTUP_ANNUAL=
SIMPLEBEACON_STARTUP_ANNUAL_PRICE_ID=
STRIPE_PRICE_ID_GROWTH_MONTHLY=
SIMPLEBEACON_GROWTH_PRICE_ID=
STRIPE_PRICE_ID_GROWTH_ANNUAL=
SIMPLEBEACON_GROWTH_ANNUAL_PRICE_ID=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_TEAMS_MONTHLY=
STRIPE_PRICE_ID_TEAMS_ANNUAL=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_PRICE_ID_RUNTIME_SHIELD=
SIMPLEBEACON_RUNTIME_SHIELD_ID=
# Slack/Discord incoming webhook URL for real-time purchase notifications.
# Slack:  https://hooks.slack.com/services/T.../B.../...
# Discord: https://discord.com/api/webhooks/.../...
