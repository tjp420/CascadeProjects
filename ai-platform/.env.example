# --- Email / certificate delivery (required for automatic PDF delivery) ---
# Primary: Resend REST API (recommended)
#   Get API key from: https://resend.com/api-keys
#   The app auto-detects Resend keys (starts with "re_")
RESEND_API_KEY=
RESEND_FROM=
#
# Fallback: SMTP (only used if Resend API fails)
#   Resend SMTP:  SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=re_xxxxxxxx
#   SendGrid:     SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey, SMTP_PASS=SG.xxxxxxxx
#   Mailgun:      SMTP_HOST=smtp.mailgun.org, SMTP_USER=postmaster@..., SMTP_PASS=<your-password>
#   Gmail:        SMTP_HOST=smtp.gmail.com,   SMTP_USER=you@gmail.com,   SMTP_PASS=<app-password>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
# Production: certificates@simplebeacon.ai (or your verified sending domain)
SMTP_FROM=noreply@localhost
SMTP_SECURE=true

# --- CI / dev-only test hooks (optional) ---
RUN_LIVE_GATEWAY_TEST=

