# --- Email / certificate delivery (required for automatic PDF delivery) ---
# Primary: Resend REST API (recommended)
#   Get API key from: https://resend.com/api-keys
#   The app auto-detects Resend keys (starts with "re_")
RESEND_API_KEY=
RESEND_FROM=
#
# Fallback: SMTP via Zoho Mail (Canadian data center)
#   Used when Resend API fails. Generate an app-specific password in
#   Zoho Mail → Settings → Mail Accounts → SMTP/IMAP.
#   Resend SMTP relay is used automatically when RESEND_API_KEY is set
#   and SMTP_HOST/SMTP_USER/SMTP_PASS are not configured.
SMTP_HOST=smtp.zohocloud.ca
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Production: admin@simplebeacon.ai (or your verified sending domain)
SMTP_FROM=admin@simplebeacon.ai

