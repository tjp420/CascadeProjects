# --- Generic placeholders referenced by docs / recipes ---

# ==============================================================================
# AUDITING, HYBRID CRYPTOGRAPHY & DEPLOYMENT MANAGEMENT (Tracks 5-8)
# ==============================================================================

# Track 5: Admin Rate Limiting & Throttle Mechanics
ADMIN_THROTTLE_CAPACITY=20          # Total capacity of the token bucket
ADMIN_THROTTLE_LEAK_RATE=5          # Rate at which tokens refill per second
ADMIN_THROTTLE_RESERVE_PCT=25       # Percentage of capacity reserved for fallback
ADMIN_THROTTLE_IPV4_MASK=24         # IPv4 subnet mask for per-subnet buckets
ADMIN_THROTTLE_IPV6_MASK=64         # IPv6 subnet mask for per-subnet buckets

# Track 6: Quantum-Resistant Hybrid Handshake & mTLS Topology
CLUSTER_QUANTUM_HYBRID=0            # Set to 1 to enforce post-quantum hybrid KEM
QUANTUM_DEGRADE_ALLOWED=0           # Fail-closed (0) or fallback to classic ECDH (1)
CLUSTER_CERT=/path/to/cluster.crt   # Absolute path to the mutual TLS public certificate
CLUSTER_KEY=/path/to/cluster.key    # Absolute path to the mutual TLS private key
CLUSTER_CA_CERT=                    # Optional CA cert for mTLS verification
CLUSTER_KEYRING_PORT=7000           # Port for cluster keyring sync transport
CLUSTER_NODES=                      # Comma-separated host:port list of cluster peers
CLUSTER_HEARTBEAT_MS=5000           # Heartbeat interval for cluster peer discovery
CLUSTER_HEARTBEAT_TIMEOUT_MS=15000  # Timeout before a peer is declared dead

# Track 8: Perfect Forward Secrecy (PFS) Ratcheting & Memory Hardening
REKEY_INTERVAL_SEC=3600             # Time window in seconds between ephemeral re-keys
HYBRID_MAX_QUEUE_BYTES=16777216     # 16 MB boundary preventing OOM under re-key locks

# JWT Token Configuration
