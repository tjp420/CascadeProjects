{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022"]
  },
  "include": ["server/**/*", "web/**/*", "tools/**/*", "packages/**/*"],
  "exclude": ["node_modules", "dist", "build", "coverage", ".simplebeacon"]
}
