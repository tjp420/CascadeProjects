# DEPRECATED — use the canonical template at the repository root.
#   copy ../../.env.example to ../../.env
#
# Production / v1-internal overlays:
#   ../../.env.production.example
#   ../../.env.v1-internal.example
#
# Legacy FastAPI / microservice keys retained below for reference only.
# New work should use the root template above.

# Environment Variables Template
# Copy this file to .env and configure with your actual values
# DO NOT commit .env to version control

# API Server Configuration (FastAPI)
API_HOST=localhost
API_PORT=8080
API_TIMEOUT=30000

# Database Configuration
USE_SQLITE=true
SQLITE_DB_PATH=./dashboard.db

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info
DEBUG=false

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Stripe Payment Configuration (REQUIRED for payment features)
STRIPE_SECRET_KEY=sk_test_your_actual_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_actual_stripe_public_key

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Celery and Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_WEBSOCKETS=true
