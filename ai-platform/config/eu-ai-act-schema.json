{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EU AI Act - SimpleBeacon Mapping",
  "type": "object",
  "properties": {
    "assessmentId": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "moduleAssessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": { "type": "string" },
          "pass": { "type": "boolean" },
          "issues": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    }
  },
  "required": [
    "assessmentId",
    "generatedAt",
    "project",
    "score",
    "moduleAssessments"
  ]
}
