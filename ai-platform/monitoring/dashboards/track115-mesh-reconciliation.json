{
  "schemaVersion": 38,
  "title": "Track 115 — Mesh State Reconciliation",
  "uid": "track115-mesh-reconciliation",
  "tags": ["track115", "mesh", "hsm-vault"],
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Mesh State Reconciliation & Challenge Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(hsm_zk_mesh_state_reconciled_total[5m])",
          "legendFormat": "Reconciliations/s",
          "refId": "A"
        },
        {
          "expr": "rate(hsm_meshgate_challenge_issued_total[5m])",
          "legendFormat": "Challenges/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Mesh Claim Drop Ratio (5m)",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(hsm_meshgate_challenge_issued_total[5m]) / (rate(hsm_zk_mesh_state_reconciled_total[5m]) + rate(hsm_meshgate_challenge_issued_total[5m]) + 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Epoch Finality Completions (1h total)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "increase(hsm_epoch_finality_completed_total[1h])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active Alerts — Mesh Reconciliation",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=~\"Mesh.*\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {
              "alertname": "Alert",
              "alertstate": "State",
              "severity": "Severity"
            }
          }
        }
      ]
    }
  ]
}
