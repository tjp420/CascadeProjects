{
  "schemaVersion": 38,
  "title": "DKG Gossip Operations",
  "uid": "dkg-operations",
  "tags": ["dkg", "gossip", "cluster-keyring-sync"],
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "DKG Session Initiation vs Completion Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(hsm_dkg_session_initiated_total[5m])",
          "legendFormat": "Initiated/s",
          "refId": "A"
        },
        {
          "expr": "rate(hsm_dkg_session_completed_total[5m])",
          "legendFormat": "Completed/s",
          "refId": "B"
        },
        {
          "expr": "rate(hsm_dkg_session_timeout_total[5m])",
          "legendFormat": "Timeouts/s",
          "refId": "C"
        }
      ]
    },
    {
      "id": 2,
      "title": "DKG Message Throughput by Type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(hsm_dkg_commit_received_total[5m])",
          "legendFormat": "Commits/s",
          "refId": "A"
        },
        {
          "expr": "rate(hsm_dkg_share_received_total[5m])",
          "legendFormat": "Shares/s",
          "refId": "B"
        },
        {
          "expr": "rate(hsm_dkg_complaint_filed_total[5m])",
          "legendFormat": "Complaints/s",
          "refId": "C"
        },
        {
          "expr": "rate(hsm_dkg_invalid_message_total[5m])",
          "legendFormat": "Invalid/s",
          "refId": "D"
        }
      ]
    },
    {
      "id": 3,
      "title": "DKG Share Rejection Rate (5m)",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(hsm_dkg_share_rejected_total[5m]) / (rate(hsm_dkg_share_received_total[5m]) + 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total DKG Sessions Completed",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "hsm_dkg_session_completed_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total Nodes Disqualified",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "hsm_dkg_node_disqualified_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "DKG Isolation Violations",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "rate(hsm_dkg_isolation_violation_total[5m])",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "Violations/s"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "DKG Round Duration (p95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear"
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(hsm_dkg_round_duration_ms_bucket[5m]))",
          "legendFormat": "p95 duration",
          "refId": "A"
        }
      ]
    }
  ]
}
