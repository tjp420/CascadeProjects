{
  "schemaVersion": 38,
  "title": "STEK Lifecycle",
  "uid": "stek-lifecycle",
  "tags": [
    "stek",
    "key-rotation",
    "cluster-keyring-sync"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "STEK Rotation Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(hsm_stek_rotation_total[5m])",
          "legendFormat": "Rotations/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active STEK Count",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 2
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "hsm_stek_active_count",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Retired STEK Count (in window)",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "hsm_stek_retired_count",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total STEK Rotations",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "hsm_stek_rotation_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "STEK Validation Failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(hsm_stek_validation_failed_total[5m])",
          "legendFormat": "Validation failures/s",
          "refId": "A"
        },
        {
          "expr": "rate(hsm_stek_validation_total[5m])",
          "legendFormat": "Validations/s",
          "refId": "B"
        }
      ]
    }
  ]
}