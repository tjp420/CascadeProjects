# Simplebeacon Docker stack — copy to .env and adjust as needed

# Dashboard
SIMPLEBEACON_PORT=54355
SIMPLEBEACON_WS_PORT=8081
NODE_ENV=production

# Metrics collector (profile: collector or full)
SIMPLEBEACON_COLLECT_INTERVAL_SEC=600
SIMPLEBEACON_DASHBOARD_TOKEN=

# Phase 2 database (profile: db or full)
ENABLE_DATABASE=false
ENABLE_REDIS=false
DATABASE_URL=postgresql://cascade_user:secure_password@postgres:5432/cascade_ai_platform
REDIS_URL=redis://redis:6379
SIMPLEBEACON_POSTGRES_PORT=5432
SIMPLEBEACON_REDIS_PORT=6379
REQUIRE_AUTH=true
SEED_DEMO_USERS=false
ALLOW_LEGACY_LOGIN=false

# GitHub Actions webhook (host machine / tunnel URL)
# SIMPLEBEACON_DASHBOARD_URL=http://host.docker.internal:54355

# Cloud Teams ($49/mo) — auto-enables when STRIPE_SECRET_KEY + STRIPE_PRICE_ID are set
SIMPLEBEACON_MONETIZATION_ENABLED=false
SIMPLEBEACON_APP_URL=https://simplebeacon.ai
# STRIPE_SECRET_KEY=rk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# SIMPLEBEACON_BYPASS_EMAIL=you@example.com
# SIMPLEBEACON_PAID_API_LIMIT=100

# v1-internal production profile
# REQUIRE_AUTH=true
# JWT_SECRET=...
# JWT_REFRESH_SECRET=...
