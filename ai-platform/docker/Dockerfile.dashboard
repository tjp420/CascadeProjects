# Simplebeacon dashboard image — build context is ai-platform root
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache bash curl tini

COPY package.json package-lock.json ./
COPY packages/simplebeacon-cli/package.json packages/simplebeacon-cli/

RUN npm ci --omit=dev

COPY packages/simplebeacon-cli packages/simplebeacon-cli
COPY .simplebeacon .simplebeacon
COPY gguf-dashboard-server.js fixed-server.js ./
COPY server server
COPY src src
COPY web web
COPY data data
COPY data-central data-central

ENV NODE_ENV=production
ENV PORT=54355

EXPOSE 54355 8081

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:54355/api/simplebeacon/baseline').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "gguf-dashboard-server.js"]
