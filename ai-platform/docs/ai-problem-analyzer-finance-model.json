    "probabilities": {
      "conservative": 0.35,
      "moderate": 0.45,
      "aggressive": 0.2
    },
    "scenarios": {
      "conservative": {
        "year1_arr": 50000,
        "implementation_cost_year1": 28000,
        "monthly_churn_assumption": 0.07,
        "notes": "Based on slow adoption and higher retention risk."
      },
      "moderate": {
        "year1_arr": 150000,
        "implementation_cost_year1": 34000,
        "monthly_churn_assumption": 0.05,
        "notes": "Base case from current monetization assumptions."
      },
      "aggressive": {
        "year1_arr": 300000,
        "implementation_cost_year1": 45000,
        "monthly_churn_assumption": 0.035,
        "notes": "Requires sustained conversion and low churn."
      }
    }
  },
  "formulas": {
    "gross_profit": "year1_arr * base_gross_margin",
    "net_value": "gross_profit - implementation_cost_year1",
    "roi_percent": "(net_value / implementation_cost_year1) * 100",
    "monthly_gross_profit": "gross_profit / 12",
    "payback_months": "implementation_cost_year1 / monthly_gross_profit",
    "estimated_year1_customers": "year1_arr / (base_price_per_customer_per_month * 12)",
    "expected_value_net": "sum(probability_i * net_value_i)",
    "expected_value_cost": "sum(probability_i * implementation_cost_i)",
    "expected_value_roi_percent": "(expected_value_net / expected_value_cost) * 100",
    "expected_value_payback_months": "sum(probability_i * payback_months_i)"
  },
