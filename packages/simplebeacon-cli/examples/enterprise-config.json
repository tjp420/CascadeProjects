{
  "profile": "enterprise",
  "license": {
    "required": true,
    "comment": "Place signed license at ~/.simplebeacon/license.json or .simplebeacon/license.json — verified offline (Ed25519), never via Stripe API from the CLI."
  },
  "scanPaths": [],
  "productionPaths": ["server/", "src/", "app/", "lib/", "api/", "services/"],
  "gate": {
    "failOn": ["high", "critical"],
    "warnOn": ["medium", "low"]
  },
  "rules": {
    "credentials": { "enabled": true, "scanProduction": true },
    "enterprise-guardrail-patterns": {
      "enabled": true,
      "severity": "high",
      "tokenCapSeverity": "high",
      "extraLeakTokens": ["internal_customer_id", "prod_vault_secret"]
    }
  }
}
