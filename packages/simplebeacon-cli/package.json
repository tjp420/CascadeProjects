{
  "name": "simplebeacon",
  "version": "1.1.2",
  "description": "Local release-hygiene gate for AI-assisted code — MCP snippet scans, full-repo --gate for CI, credential patterns, sample JSON in prod routes, fiction KPIs. Offline by default.",
  "author": "SimpleBeacon",
  "license": "MIT",
  "homepage": "https://simplebeacon.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjp420/simplebeacon.git"
  },
  "bugs": {
    "url": "https://github.com/tjp420/simplebeacon/issues"
  },
  "main": "src/index.js",
  "module": "src/index.mjs",
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "require": "./src/index.js"
    },
    "./scan": "./src/scan.js",
    "./gate": "./src/gate.js",
    "./config": "./src/config.js",
    "./report": "./src/index.js",
    "./compliance": "./src/compliance-checklist.js",
    "./fiction": "./src/rules/ai-fiction-detection.js",
    "./doctor": "./src/doctor.js",
    "./fix-dry-run": "./src/fix-dry-run.js",
    "./mcp": "./src/mcp/stdio-server.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "simplebeacon": "./bin/simplebeacon.js",
    "simplebeacon-proxy": "./bin/simplebeacon-proxy.js",
    "simplebeacon-mcp": "./bin/simplebeacon-mcp.js",
    "samplebeacon": "./bin/simplebeacon.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/**/*.test.js\"",
    "proxy": "node bin/simplebeacon-proxy.js",
    "mcp": "node bin/simplebeacon-mcp.js --offline",
    "mcp:smoke": "node bin/simplebeacon-mcp.js --smoke-test",
    "prepublishOnly": "npm test && npm run mcp:smoke",
    "pack:check": "npm pack --dry-run",
    "build": "node -c bin/simplebeacon.js && node -c src/index.js",
    "lint": "npx eslint .",
    "format": "npx prettier --write \"src/**/*.js\" \"bin/**/*.js\" \"tests/**/*.js\"",
    "quality:check": "npm run build && npm run lint && npm test && npm run mcp:smoke"
  },
  "keywords": [
    "simplebeacon",
    "simplebeacon",
    "mock-data",
    "ai-fiction",
    "code-quality",
    "ci-gate",
    "pre-commit",
    "github-action",
    "devsecops",
    "mcp",
    "cursor",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0",
    "vscode": "^1.90.0"
  },
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.8.4"
  },
  "optionalDependencies": {
    "@simplebeacon/intelligence": "1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "!src/**/*.test.js",
    "!src/**/*.test.cjs",
    "!src/**/*.test.mjs",
    "!src/**/*.test.ts",
    "!src/**/*.spec.js",
    "!src/**/*.spec.cjs",
    "!src/**/*.spec.mjs",
    "!src/**/*.spec.ts",
    "LICENSE",
    "README.md"
  ]
}
