[
  {
    "id": "SB-AI-001",
    "name": "Debug print statement in non-JS language",
    "pattern": "(?:^|\\s)(?:pprint\\s*\\(|dbg!\\s*\\(|fprintf\\s*\\(stderr|System\\.err\\.println|NSLog\\s*\\(|print_r\\s*\\(|var_dump\\s*\\(|dd\\s*\\(|dump\\s*\\(|ray\\s*\\()",
