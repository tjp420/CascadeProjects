# SimpleBeacon Environment Configuration
# Copy to .env and fill in real values for production.
# NOTE: .env uses localhost defaults for local development.
#       .env.example is a copy-paste template with safe defaults.
#       Production overrides are noted inline.

# ── App URL (required by tool scripts and billing emails) ──
# Production: https://simplebeacon.ai
SIMPLEBEACON_APP_URL=http://localhost:3001
PUBLIC_URL=http://localhost:3001
PUBLIC_APP_URL=http://localhost:3001

# ── Stripe (live mode) ──
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe Dashboard → Products → Pricing
STRIPE_PRICE_ID_TEAMS_MONTHLY=price_...
STRIPE_PRICE_ID_TEAMS_ANNUAL=price_...
STRIPE_PRICE_ID_EXECUTIVE_CLEARANCE=price_...
STRIPE_PRICE_ID_INSTANT_REPORT=price_...
STRIPE_PRICE_ID_EU_AI_ACT_SPRINT=price_...
STRIPE_PRICE_ID_CONTINUOUS_SHIELD=price_...
STRIPE_PRICE_ID_RUNTIME_SHIELD=price_...


# ── License Token Signing ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIMPLEBEACON_LICENSE_SECRET=change-me-in-production

# ── Email (Resend is primary; SMTP is fallback; disk queue is last resort) ──
RESEND_API_KEY=re_...
RESEND_FROM=certificates@simplebeacon.ai

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.YOUR_API_KEY
SMTP_FROM=certificates@simplebeacon.ai
SMTP_SECURE=false

# ── Stripe Checkout Links (optional — falls back to hardcoded defaults) ──
STRIPE_LINK_INSTANT=
STRIPE_LINK_EXECUTIVE=
STRIPE_LINK_EU_SPRINT=

# ── Render deploy (optional) ──
RENDER_API_KEY=
RENDER_SERVICE_ID=

# ── Dashboard ──
SIMPLEBEACON_INTERNAL_DASHBOARD=false
SIMPLEBEACON_LANDING=true

# ── Test Database (optional — overrides default app.db in tests) ──
SIMPLEBEACON_TEST_DB=

# ── Documentation / Example vars (referenced in pattern docs and quick-actions) ──
API_KEY=
SECRET_KEY=
API_URL=
DEBUG=
X=

# ── Simplebeacon CLI internals ──
# These are referenced by the CLI but optional; defaults apply if omitted.
AGENT_MODEL=
REFRESH_TOKEN_EXPIRES_IN=
SIMPLEBEACON_ENTERPRISE_SETUP_ID=
SIMPLEBEACON_ENTERPRISE_RETAINER_ID=
SIMPLEBEACON_FIX_MODEL=
SIMPLEBEACON_ANON_SALT=
SIMPLEBEACON_ANON_HMAC=
SIMPLEBEACON_FULL_SCAN_MAX_FILES=
SIMPLEBEACON_FULL_SCAN_LOG_EVERY=
SIMPLEBEACON_FULL_SCAN_MAX_BYTES=
SIMPLEBEACON_LIVE_FILE_LOG=
SIMPLEBEACON_PARALLEL=
SIMPLEBEACON_PARALLEL_MIN_FILES=
SIMPLEBEACON_PARALLEL_MAX_WORKERS=
SIMPLEBEACON_LICENSE_TOKEN=
SIMPLEBEACON_PYTHON=
SIMPLEBEACON_PROGRESS_WRITE_MS=
SIMPLEBEACON_PROGRESS_FILE=
SIMPLEBEACON_PROXY_MAX_BODY=
SIMPLEBEACON_PROXY_UPSTREAM=
SIMPLEBEACON_PROXY_PORT=
SIMPLEBEACON_REGISTRY_CHECK=

# ── Node / Hosting ──
NODE_ENV=development
# Production (e.g., Render): 10000
PORT=3001
