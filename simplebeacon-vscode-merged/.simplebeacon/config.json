{
  "profile": "eu-ai-act",
  "scanPaths": [
    "."
  ],
  "productionPaths": [
    "src/"
  ],
  "allowedAnalysisRoots": [
    "C:/Users/user/CascadeProjects",
    "C:/Users/user/CascadeProjects/simplebeacon-vscode-merged"
  ],
  "fullDirectoryScan": true,
  "fullDirectoryScanMaxFiles": 50000,
  "ignore": [
    "node_modules/**",
    "out/**",
    "dist/**",
    "coverage/**",
    "*.vsix",
    "releases/**",
    "*.log",
    "package-lock.json",
    ".simplebeacon/**",
    ".vscode-test/**",
    ".vscode-test/",
    ".vscode/launch.json",
    "media/d3.v7.min.js",
    "media/sidebar.js",
    "media/panel.js",
    "build-extension.js",
    "replace-dashboard.js",
    "ai-platform/.env.v1-internal",
    "**/re-attestation-metadata.json",
    "**/roadmap-ai-agent-2026-06-12.json",
    "**/simplebeacon-dashboard/tsconfig.json",
    "src/fixes/remediationProvider.ts",
    "src/fixes/findingConverter.ts",
    "src/enhancedAIProvider.ts",
    "src/realtimeMonitor.ts",
    "src/roadmapProvider.ts",
    "src/modernSidebarProvider.ts",
    "src/aiPlatform/realtimeMonitor.ts",
    "src/auth/authManager.ts",
    "src/extension.ts",
    "**/AnalyzeEngineGrid.js"
  ],
  "rules": {
    "credentials": {
      "enabled": true,
      "scanProduction": true
    },
    "json-schema": {
      "enabled": false
    },
    "sample-consistency": {
      "enabled": true
    },
    "roadmap": {
      "enabled": true
    },
    "production-leak": {
      "enabled": true,
      "severity": "high"
    },
    "fiction-kpi-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "llm-slop-patterns": {
      "enabled": true,
      "severity": "medium",
      "registryCheck": false
    },
    "agency-handoff-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "eu-ai-act-patterns": {
      "enabled": false,
      "severity": "medium"
    },
    "jest-baseline": {
      "enabled": false,
      "runTests": false
    },
    "token-bleed-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "architecture-drift-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "file-reduction": {
      "enabled": false,
      "dryRun": true
    }
  },
  "gate": {
    "failOn": [
      "critical"
    ],
    "warnOn": [
      "high",
      "medium",
      "low"
    ]
  }
}