    { regex: /^[a-zA-Z]:\/Users\/[^/]+(\/.+)?$/i, replace: (m, rest) => rest ? `…${rest}` : '…' },
    { regex: /^\/Users\/[^/]+(\/.+)?$/, replace: (m, rest) => rest ? `…${rest}` : '…' },
    { regex: /^\/home\/[^/]+(\/.+)?$/, replace: (m, rest) => rest ? `…${rest}` : '…' },
