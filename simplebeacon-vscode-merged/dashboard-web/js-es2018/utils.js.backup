'use strict';
/**
 * @module utils
 * Flat utility module — ~113 helper functions for string, DOM, async, array,
 * object, storage, formatting, path redaction, and clipboard operations.
 * Named exports are tree-shakeable; import individually for best bundle size.
 *
 * Import from `'./utils'` to get every utility (frozen namespace):
 * ```js
 * import Utils from './utils';
 * Utils.escapeHtml('<div>');
 * Object.isFrozen(Utils); // true
 * ```
 *
 * Named imports (tree-shakeable):
 * ```js
 * import { escapeHtml, fetchWithTimeout } from './utils';
 * ```
 *
 * Discovery helpers:
 * ```js
 * getExportNames(); // ['escapeHtml', 'clamp', 'deepClone', ...]
 * ```
 *
 * Integrity check:
 * ```js
 * validateBarrelIntegrity(); // { valid: true, errors: [] }
 * ```
 *
 * Metadata:
 * ```js
 * __barrel__.name;    // 'simplebeacon-dashboard-utils'
 * __barrel__.version; // '1.0.0'
 * ```
 *
 * Composition utilities:
 * ```js
 * compose(f, g)(x); // f(g(x))
 * pipe(f, g)(x);   // g(f(x))
 * zipWith([1,2], [3,4], (a,b) => a + b); // [4, 6]
 * ```
 *
 * @file dashboard-web/js/utils.js
 */

/**
 * Barrel metadata shape.
 * @typedef {Object} BarrelMeta
 * @property {string} name
 * @property {string} description
 * @property {number} exportCount
 * @property {string} version
 * @property {string} timestamp
 * @property {ReadonlyArray<string>} exports
 */
