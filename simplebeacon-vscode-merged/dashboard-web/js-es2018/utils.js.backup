    <div class="empty-state card">
      ${iconHtml}
      <p class="empty-state-title">${escapeHtml(title)}</p>
      ${bodyHtml}
      ${actionsHtml}
    </div>
  `.trim();
    if (actions.some(a => typeof a.onClick === 'function')) {
        return {
            html,
            attach(container) {
