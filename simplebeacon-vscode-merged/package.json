{
  "name": "simplebeacon-vscode",
  "displayName": "SimpleBeacon AI Slop Cop",
  "description": "Offline AI code audit — 38 analyzer engines, zero source-code upload, board-ready compliance reports for AI slop, credential leaks, and EU AI Act / SOC 2 gaps.",
  "homepage": "https://simplebeacon.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplebeacon/simplebeacon-vscode.git"
  },
  "version": "3.0.416",
  "publisher": "simplebeacon",
  "engines": {
    "vscode": "^1.84.0",
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "categories": [
    "Testing",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "security",
    "compliance",
    "AI",
    "scanner",
    "audit",
    "enhanced analysis",
    "pattern detection",
    "real-time analysis",
    "code quality",
    "GUI sidebar",
    "visual interface"
  ],
  "icon": "resources/icon.png",
  "screenshots": [
    {
      "path": "resources/screenshots/screenshot1.png",
      "label": "AI Slop Cop sidebar with scan results and gate status"
    },
    {
      "path": "resources/screenshots/screenshot2.png",
      "label": "Detailed findings with file locations and fix suggestions"
    },
    {
      "path": "resources/screenshots/screenshot3.png",
      "label": "Configuration options in VSCode settings"
    },
    {
      "path": "resources/screenshots/screenshot4.png",
      "label": "Full scan mode for comprehensive coverage"
    },
    {
      "path": "resources/screenshots/screenshot5.png",
      "label": "Exported scan report in JSON format"
    }
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:simplebeacon-modern",
    "onView:simplebeacon-modern-explorer",
    "onCommand:simplebeacon.scanWorkspace",
    "onCommand:simplebeacon.showReport",
    "onCommand:simplebeacon.clearResults",
    "onCommand:simplebeacon.setApiToken",
    "onCommand:simplebeacon.openSettings",
    "onCommand:simplebeacon.showWelcome",
    "onCommand:simplebeacon.openAnalyze",
    "onCommand:simplebeacon.installLocalAgent",
    "onCommand:simplebeacon.startLocalAgent"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "simplebeacon.scanWorkspace",
        "title": "Scan Workspace",
        "category": "SimpleBeacon",
        "icon": "$(search)"
      },
      {
        "command": "simplebeacon.setScanPath",
        "title": "Set Default Scan Path",
        "category": "SimpleBeacon",
        "icon": "$(folder-opened)"
      },
      {
        "command": "simplebeacon.clearResults",
        "title": "Clear Results",
        "category": "SimpleBeacon",
        "icon": "$(clear-all)"
      },
      {
        "command": "simplebeacon.resetScanQuota",
        "title": "Reset Scan Quota",
        "category": "SimpleBeacon",
        "icon": "$(debug-restart)"
      },
      {
        "command": "simplebeacon.restartDataServer",
        "title": "Restart Data Server",
        "category": "SimpleBeacon",
        "icon": "$(debug-restart)"
      },
      {
        "command": "simplebeacon.openSettings",
        "title": "Open Settings Panel",
        "category": "SimpleBeacon",
        "icon": "$(gear)"
      },
      {
        "command": "simplebeacon.refreshRelayPort",
        "title": "Refresh Relay Port",
        "category": "SimpleBeacon",
        "icon": "$(extensions-refresh)"
      },
      {
        "command": "simplebeacon.showReport",
        "title": "Show Report Dashboard",
        "category": "SimpleBeacon",
        "icon": "$(dashboard)"
      },
      {
        "command": "simplebeacon.openReport",
        "title": "Open Report",
        "category": "SimpleBeacon",
        "icon": "$(report)"
      },
      {
        "command": "simplebeacon.generateCertificate",
        "title": "Generate Certificate",
        "category": "SimpleBeacon",
        "icon": "$(verified)"
      },
      {
        "command": "simplebeacon.exportReport",
        "title": "Export Report (JSON)",
        "category": "SimpleBeacon",
        "icon": "$(save)"
      },
      {
        "command": "simplebeacon.exportReportJson",
        "title": "Export Analyzer Report (Structured JSON)",
        "category": "SimpleBeacon",
        "icon": "$(json)"
      },
      {
        "command": "simplebeacon.exportAIReport",
        "title": "Export AI Report (Markdown/JSON/XML)",
        "category": "SimpleBeacon",
        "icon": "$(export)"
      },
      {
        "command": "simplebeacon.loadReport",
        "title": "Load Report (JSON)",
        "category": "SimpleBeacon",
        "icon": "$(file-add)"
      },
      {
        "command": "simplebeacon.enhancedAnalysis",
        "title": "Enhanced AI Analysis",
        "category": "SimpleBeacon",
        "icon": "$(sparkle)"
      },
      {
        "command": "simplebeacon.realtimeAnalysis",
        "title": "Real-time Analysis",
        "category": "SimpleBeacon",
        "icon": "$(pulse)"
      },
      {
        "command": "simplebeacon.patternDetection",
        "title": "Pattern Detection",
        "category": "SimpleBeacon",
        "icon": "$(search)"
      },
      {
        "command": "simplebeacon.modelHealth",
