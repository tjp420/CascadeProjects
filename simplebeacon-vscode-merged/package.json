{
  "name": "simplebeacon",
  "displayName": "SimpleBeacon AI Slop Cop",
  "description": "Privacy-first source code scanner with modern GUI sidebar interface. Analyze your repository for security, compliance, and quality issues with intelligent pattern detection, real-time analysis, and interactive visual controls.",
  "homepage": "https://simplebeacon.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplebeacon/simplebeacon-vscode.git"
  },
  "version": "3.0.1",
  "publisher": "simplebeacon",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Testing",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "security",
    "compliance",
    "AI",
    "scanner",
    "audit",
    "enhanced analysis",
    "pattern detection",
    "real-time analysis",
    "code quality",
    "GUI sidebar",
    "visual interface"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "simplebeacon.scanWorkspace",
        "title": "Scan Workspace",
        "category": "SimpleBeacon",
        "icon": "$(search)"
      },
      {
        "command": "simplebeacon.clearResults",
        "title": "Clear Results",
        "category": "SimpleBeacon",
        "icon": "$(clear-all)"
      },
      {
        "command": "simplebeacon.openSettings",
        "title": "Open Settings Panel",
        "category": "SimpleBeacon",
        "icon": "$(gear)"
      },
      {
        "command": "simplebeacon.showReport",
        "title": "Show Report Dashboard",
        "category": "SimpleBeacon",
        "icon": "$(dashboard)"
      },
      {
        "command": "simplebeacon.generateCertificate",
        "title": "Generate Certificate",
        "category": "SimpleBeacon",
        "icon": "$(verified)"
      },
      {
        "command": "simplebeacon.exportReport",
        "title": "Export Report (JSON)",
        "category": "SimpleBeacon",
        "icon": "$(save)"
      },
      {
        "command": "simplebeacon.exportReportJson",
        "title": "Export Analyzer Report (Structured JSON)",
        "category": "SimpleBeacon",
        "icon": "$(json)"
      },
      {
        "command": "simplebeacon.exportAIReport",
        "title": "Export AI Report (Markdown/JSON/XML)",
        "category": "SimpleBeacon",
        "icon": "$(export)"
      },
      {
        "command": "simplebeacon.enhancedAnalysis",
        "title": "Enhanced AI Analysis",
        "category": "SimpleBeacon",
        "icon": "$(sparkle)"
      },
      {
        "command": "simplebeacon.realtimeAnalysis",
        "title": "Real-time Analysis",
        "category": "SimpleBeacon",
        "icon": "$(pulse)"
      },
      {
        "command": "simplebeacon.patternDetection",
        "title": "Pattern Detection",
        "category": "SimpleBeacon",
        "icon": "$(search)"
      },
      {
        "command": "simplebeacon.modelHealth",
        "title": "Model Health Status",
        "category": "SimpleBeacon",
        "icon": "$(heart)"
      },
      {
        "command": "simplebeacon.showCodeMap",
        "title": "Show Code Map",
        "category": "SimpleBeacon",
        "icon": "$(map)"
      },
      {
        "command": "simplebeacon.showRemediationGuide",
        "title": "Show Fix Guide",
        "category": "SimpleBeacon",
        "icon": "$(book)"
      },
      {
        "command": "simplebeacon.openEnhancedDashboard20",
        "title": "Open Enhanced Dashboard 2.0",
        "category": "SimpleBeacon",
        "icon": "$(dashboard)"
      },
      {
        "command": "simplebeacon.runAdvancedAnalytics",
        "title": "Run Advanced Analytics",
        "category": "SimpleBeacon",
        "icon": "$(graph)"
      },
      {
        "command": "simplebeacon.showTeamDashboard",
        "title": "Show Team Dashboard",
        "category": "SimpleBeacon",
        "icon": "$(organization)"
      },
      {
        "command": "simplebeacon.setApiToken",
        "title": "Set API Token",
        "category": "SimpleBeacon",
        "icon": "$(key)"
      },
      {
        "command": "simplebeacon.clearApiToken",
        "title": "Clear API Token",
        "category": "SimpleBeacon",
        "icon": "$(trash)"
      },
      {
        "command": "simplebeacon.setServerUrl",
        "title": "Set API Server URL",
        "category": "SimpleBeacon",
        "icon": "$(server)"
      },
      {
        "command": "simplebeacon.toggleRealtimeMonitoring",
        "title": "Toggle AI Slop Real-time Monitoring",
        "category": "SimpleBeacon",
        "icon": "$(eye)"
      },
      {
        "command": "simplebeacon.openBrowser",
        "title": "Open Browser in IDE",
        "category": "SimpleBeacon",
        "icon": "$(globe)"
      },
      {
        "command": "simplebeacon.scanFolder",
        "title": "Scan Folder...",
        "category": "SimpleBeacon",
        "icon": "$(folder-opened)"
      },
      {
        "command": "simplebeacon.uploadReport",
        "title": "Upload & Validate Report",
        "category": "SimpleBeacon",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "simplebeacon.refreshResults",
        "title": "Refresh Results",
        "category": "SimpleBeacon",
        "icon": "$(refresh)"
      },
      {
        "command": "simplebeacon.openIssue",
        "title": "Open Issue",
        "category": "SimpleBeacon"
      },
      {
        "command": "simplebeacon.openAnalyze",
        "title": "Open Analyze Page",
        "category": "SimpleBeacon",
        "icon": "$(graph)"
      },
      {
        "command": "simplebeacon.openUpload",
        "title": "Open Upload Page",
        "category": "SimpleBeacon",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "simplebeacon.openPreview",
        "title": "Open Preview",
        "category": "SimpleBeacon",
        "icon": "$(browser)"
      },
      {
        "command": "simplebeacon.openAiContext",
        "title": "Open AI Context File",
        "category": "SimpleBeacon",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "simplebeacon.sendToAi",
        "title": "Send Scan to AI Agent",
        "category": "SimpleBeacon",
        "icon": "$(robot)"
      },
      {
        "command": "simplebeacon.refreshDashboard",
        "title": "Refresh Dashboard",
        "category": "SimpleBeacon"
      },
      {
        "command": "simplebeacon.setMonitorDirectory",
        "title": "Set Real-time Monitor Directory",
        "category": "SimpleBeacon",
        "icon": "$(folder-opened)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simplebeacon-sidebar",
          "title": "SimpleBeacon",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "simplebeacon-sidebar": [
        {
          "id": "simplebeacon-modern",
          "name": "SimpleBeacon",
          "type": "webview",
          "icon": "$(shield)"
        }
      ],
      "explorer": [
        {
          "id": "simplebeacon-summary",
          "name": "SimpleBeacon",
          "icon": "$(shield)"
        },
        {
          "id": "simplebeacon-roadmap",
          "name": "Roadmap",
          "icon": "$(tasklist)"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "simplebeacon.scanWorkspace",
          "when": "true"
        },
        {
          "command": "simplebeacon.clearResults",
          "when": "true"
        },
        {
          "command": "simplebeacon.openSettings",
          "when": "true"
        },
        {
          "command": "simplebeacon.showReport",
          "when": "true"
        },
        {
          "command": "simplebeacon.setApiToken",
          "when": "true"
        },
        {
          "command": "simplebeacon.clearApiToken",
          "when": "true"
        },
        {
          "command": "simplebeacon.setServerUrl",
          "when": "true"
        }
      ],
      "activitybar/context": [
        {
          "command": "simplebeacon.openSettings",
          "when": "view == simplebeacon-sidebar",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "simplebeacon.scanWorkspace",
          "when": "view == simplebeacon-modern || view == simplebeacon-summary || view == simplebeacon-roadmap",
          "group": "navigation@1"
        },
        {
          "command": "simplebeacon.clearResults",
          "when": "view == simplebeacon-modern || view == simplebeacon-summary || view == simplebeacon-roadmap",
          "group": "navigation@2"
        },
        {
          "command": "simplebeacon.showReport",
          "when": "view == simplebeacon-modern || view == simplebeacon-summary || view == simplebeacon-roadmap",
          "group": "navigation@3"
        },
        {
          "command": "simplebeacon.setApiToken",
          "when": "view == simplebeacon-modern || view == simplebeacon-summary || view == simplebeacon-roadmap",
          "group": "navigation@4"
        }
      ],
      "explorer/context": [
        {
          "command": "simplebeacon.scanFolder",
          "when": "explorerResourceIsFolder",
          "group": "simplebeacon"
        }
      ]
    },
    "configuration": {
      "title": "SimpleBeacon",
      "properties": {
        "simplebeacon.autoScanOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan workspace when opening VS Code"
        },
        "simplebeacon.maxFiles": {
          "type": "number",
          "default": 5000,
          "description": "Maximum number of files to scan"
        },
        "simplebeacon.excludePatterns": {
          "type": "array",
          "default": [
            "node_modules",
            ".git",
            "dist",
            "build",
            ".vscode",
            ".simplebeacon",
            "ai-agent",
            "ai-platform",
            "scripts",
            "ai-tools",
            "packages",
            "out"
          ],
          "description": "Glob patterns to exclude from scanning"
        },
        "simplebeacon.analysisProfile": {
          "type": "string",
          "enum": [
            "quick",
            "balanced",
            "comprehensive",
            "realtime"
          ],
          "default": "balanced",
          "description": "Analysis profile for enhanced AI analysis"
        },
        "simplebeacon.enableRealtime": {
          "type": "boolean",
          "default": false,
          "description": "Enable real-time code monitoring"
        },
        "simplebeacon.realtimeFileTypes": {
          "type": "array",
          "default": [
            "js",
            "ts",
            "jsx",
            "tsx",
            "json",
            "md",
            "py",
            "java",
            "cpp",
            "c",
            "h",
            "hpp",
            "go",
            "rs",
            "php",
            "rb",
            "swift",
            "kt",
            "scala",
            "clj",
            "hs",
            "ml",
            "elm",
            "dart"
          ],
          "description": "File types to monitor for real-time analysis"
        },
        "simplebeacon.realtimeSeverity": {
          "type": "string",
          "enum": [
            "all",
            "error",
            "warning",
            "info"
          ],
          "default": "warning",
          "description": "Minimum severity level for real-time issue detection"
        },
        "simplebeacon.realtimeDebounce": {
          "type": "number",
          "default": 1000,
          "description": "Debounce time in milliseconds for file analysis"
        },
        "simplebeacon.realtimeMonitorDirectory": {
          "type": "string",
          "default": "",
          "description": "Directory path to monitor for real-time changes. Leave empty to monitor the entire workspace."
        },
        "simplebeacon.autoStartRealtime": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start real-time monitoring when VSCode opens"
        },
        "simplebeacon.preferredAIProvider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "ollama",
            "auto"
          ],
          "default": "auto",
          "description": "Preferred AI provider for enhanced analysis"
        },
        "simplebeacon.ollamaUrl": {
          "type": "string",
          "default": "",
          "description": "Ollama server URL (e.g. http://localhost:11434). Falls back to OLLAMA_BASE_URL or LOCAL_AI_URL env vars."
        },
        "simplebeacon.agentModel": {
          "type": "string",
          "default": "",
          "description": "Ollama model name for enhanced analysis (e.g. llama3.2:latest). Falls back to AGENT_MODEL env var."
        },
        "simplebeacon.apiServerUrl": {
          "type": "string",
          "default": "",
          "description": "SimpleBeacon API server URL for cloud sync and higher-tier features. (e.g. https://api.simplebeacon.ai)"
        },
        "simplebeacon.apiToken": {
          "type": "string",
          "default": "",
          "description": "JWT Bearer token for SimpleBeacon API authentication. Falls back to secret storage if empty."
        },
        "simplebeacon.apiUrl": {
          "type": "string",
          "default": "",
          "description": "SimpleBeacon API server URL (legacy, use apiServerUrl)."
        },
        "simplebeacon.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for authenticated scans"
        },
        "simplebeacon.severityFilter": {
          "type": "string",
          "default": "medium",
          "enum": ["critical", "high", "medium", "low", "info"],
          "description": "Minimum severity to show in the issues panel"
        },
        "simplebeacon.autoMonitorAI": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start AI slop real-time monitoring when opening VS Code"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "verify:scan": "node ../scripts/verify-scan.js",
    "verify:all": "npm run compile && node ../scripts/verify-scan.js && npx @vscode/vsce package --out simplebeacon-test.vsix"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.84.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.0"
  }
}
