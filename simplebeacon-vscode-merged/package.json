        "category": "SimpleBeacon",
        "icon": "$(book)"
      },
      {
        "command": "simplebeacon.openEnhancedDashboard20",
        "title": "Open Enhanced Dashboard 2.0",
        "category": "SimpleBeacon",
        "icon": "$(dashboard)"
      },
      {
        "command": "simplebeacon.runAdvancedAnalytics",
        "title": "Run Advanced Analytics",
        "category": "SimpleBeacon",
        "icon": "$(graph)"
      },
      {
        "command": "simplebeacon.showTeamDashboard",
        "title": "Show Team Dashboard",
        "category": "SimpleBeacon",
        "icon": "$(organization)"
      },
      {
        "command": "simplebeacon.upgradeToPro",
        "title": "Upgrade to Pro",
        "category": "SimpleBeacon",
        "icon": "$(arrow-up)"
      },
      {
        "command": "simplebeacon.setApiToken",
        "title": "Set API Token",
        "category": "SimpleBeacon",
        "icon": "$(key)"
      },
      {
        "command": "simplebeacon.clearApiToken",
        "title": "Clear API Token",
        "category": "SimpleBeacon",
        "icon": "$(trash)"
      },
      {
        "command": "simplebeacon.setServerUrl",
        "title": "Set API Server URL",
        "category": "SimpleBeacon",
        "icon": "$(server)"
      },
      {
        "command": "simplebeacon.viewAccountHistory",
        "title": "View Account History",
        "category": "SimpleBeacon",
        "icon": "$(history)"
      },
      {
        "command": "simplebeacon.exportAccountHistory",
        "title": "Export Account History",
        "category": "SimpleBeacon",
        "icon": "$(file-code)"
      },
      {
        "command": "simplebeacon.toggleRealtimeMonitoring",
        "title": "Toggle AI Slop Real-time Monitoring",
        "category": "SimpleBeacon",
        "icon": "$(eye)"
      },
      {
        "command": "simplebeacon.openBrowser",
        "title": "Open Browser in IDE",
        "category": "SimpleBeacon",
        "icon": "$(globe)"
      },
      {
        "command": "simplebeacon.openGitHub",
        "title": "Open GitHub Repository",
        "category": "SimpleBeacon",
        "icon": "$(github)"
      },
      {
        "command": "simplebeacon.openDocs",
        "title": "Open Documentation",
        "category": "SimpleBeacon",
        "icon": "$(book)"
      },
      {
        "command": "simplebeacon.openInternalDashboard",
        "title": "Open Dashboard in IDE",
        "category": "SimpleBeacon",
        "icon": "$(screen-full)"
      },
      {
        "command": "simplebeacon.openDashboard40",
        "title": "Open Dashboard 4.0",
        "category": "SimpleBeacon",
        "icon": "$(layout)"
      },
      {
        "command": "simplebeacon.scanFolder",
        "title": "Scan Folder...",
        "category": "SimpleBeacon",
        "icon": "$(folder-opened)"
      },
      {
        "command": "simplebeacon.uploadReport",
        "title": "Upload & Validate Report",
        "category": "SimpleBeacon",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "simplebeacon.refreshResults",
        "title": "Refresh Results",
        "category": "SimpleBeacon",
        "icon": "$(refresh)"
      },
      {
        "command": "simplebeacon.installLocalAgent",
        "title": "Install Local Agent",
        "category": "SimpleBeacon",
        "icon": "$(desktop-download)"
      },
      {
        "command": "simplebeacon.startLocalAgent",
        "title": "Start Local Agent",
        "category": "SimpleBeacon",
        "icon": "$(play)"
      },
      {
        "command": "simplebeacon.openIssue",
        "title": "Open Issue",
        "category": "SimpleBeacon"
      },
      {
        "command": "simplebeacon.openAnalyze",
        "title": "Open Analyze Page",
        "category": "SimpleBeacon",
        "icon": "$(graph)"
      },
      {
        "command": "simplebeacon.openUpload",
        "title": "Open Upload Page",
        "category": "SimpleBeacon",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "simplebeacon.openPreview",
        "title": "Open Preview",
        "category": "SimpleBeacon",
        "icon": "$(browser)"
      },
      {
        "command": "simplebeacon.openDashboardPreview",
