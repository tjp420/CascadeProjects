# --- Fast asset hygiene lint (sub-second: encoding + path regressions) ---
echo "[lint-assets] Running pre-commit encoding & path lint..."
node .simplebeacon/qa/lint-assets.cjs
LINT_RESULT=$?
if [ $LINT_RESULT -ne 0 ]; then
  echo "[lint-assets] Asset hygiene lint failed (exit $LINT_RESULT). Commit aborted." >&2
  exit $LINT_RESULT
fi
echo "[lint-assets] Asset hygiene lint passed."

# --- Gitleaks staged-files secret scan (soft-warn if missing, Track113 runs as fallback) ---
echo "[gitleaks] Running staged-files secret scan..."
node .simplebeacon/qa/pre-commit-gitleaks.cjs
GITLEAKS_RESULT=$?
if [ $GITLEAKS_RESULT -ne 0 ]; then
  echo "[gitleaks] Secrets detected in staged files! Commit aborted." >&2
  exit $GITLEAKS_RESULT
fi

# Run SimpleBeacon gate scan as a pre-commit hook. Exits non-zero to block commit on high/critical findings.
echo "Running SimpleBeacon pre-commit scan..."
npm run sb:hook:pre-commit
RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo "SimpleBeacon pre-commit check failed (exit $RESULT). Commit aborted." >&2
  exit $RESULT
fi
echo "SimpleBeacon pre-commit passed. Proceeding with commit."
# Run local secret scanner to prevent hardcoded KEKs/secrets from being committed
echo "Running Track113 secret scanner..."
node ai-platform/server/lib/crypto/ratchet/secret-scanner.cjs || { echo "Secret scanner detected potential secrets. Commit aborted." >&2; exit 2; }
echo "[SimpleBeacon] Pre-commit passed"
