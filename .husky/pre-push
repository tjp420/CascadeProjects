#!/usr/bin/env sh
.
"$(dirname "$0")/_/husky.sh"

# Run the cross-platform pre-push secret guard.
# POSIX shell wrapper preferred; on Windows fallback to PowerShell wrapper.
if command -v sh >/dev/null 2>&1; then
  sh scripts/pre-push-secret-guard.sh
  rc=$?
  if [ $rc -ne 0 ]; then
    echo "pre-push secret guard blocked the push (exit code $rc)"
    exit $rc
  fi
else
  pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/pre-push-secret-guard.ps1
  rc=$?
  if [ $rc -ne 0 ]; then
    echo "pre-push secret guard (PowerShell) blocked the push (exit code $rc)"
    exit $rc
  fi
fi

exit 0
#!/usr/bin/env sh

echo "Running pre-push: secret scan + staged checks + tests"

# 1. Pre-push secret scan (fast, ~2s)
if command -v node >/dev/null 2>&1; then
  node scripts/pre-push-scan.js "$@"
  scan_rc=$?
  if [ $scan_rc -ne 0 ]; then
    echo "Pre-push: PUSH REJECTED — secret scanner failed or detected leaks."
    exit $scan_rc
  fi
  echo "Pre-push: secret scan passed."
else
  echo "Pre-push: Node.js not found — skipping secret scanner."
fi

# 2. Staged checks (env guard + secrets gate + pre-commit gate, ~5s)
npm run sb:hook:pre-commit
rc=$?
if [ $rc -ne 0 ]; then
  echo "pre-push hook: sb:hook:pre-commit failed (exit $rc)"
  exit $rc
fi

# 3. Quick test suite (if present, non-blocking — CI enforces strict pass)
# Skip integration tests that require external services (Docker/Redis).
# Test failures are reported but do not block the push, since CI runs
# the full suite with strict fail-closed behavior.
echo "Running quick test suite (if present)"
export SKIP_REDIS_INTEGRATION=1
npm test --workspaces --if-present || true

echo "Pre-push checks complete (test failures are non-blocking — CI enforces strict pass)"
exit 0
