#!/usr/bin/env bash
# Pre-push validation hook: scan only changed/unpushed files to avoid full-repo timeouts

echo "🔍 [Pre-Push] Running pre-flight credential audit on unpushed commits..."

# Upstream ref to compare against (adjust if needed)
UPSTREAM_REF="origin/ci/backend-bench-pr"
git fetch origin $UPSTREAM_REF >/dev/null 2>&1 || true

# Changed files in outgoing commit range
CHANGED_FILES=$(git diff --name-only $UPSTREAM_REF..HEAD)

if [ -z "$CHANGED_FILES" ]; then
  echo "ℹ️ No changes detected vs $UPSTREAM_REF — skipping secret scan."
  exit 0
fi

echo "ℹ️ Scanning changed files for secrets (count: $(echo "$CHANGED_FILES" | wc -l))."

# Use gitleaks per-file for a fast and reliable scan of changed files
if command -v npx >/dev/null 2>&1; then
  FAIL=0
  for f in $CHANGED_FILES; do
    # Skip docs and markdown files to avoid noisy false positives
    case "$f" in
      docs/*|*.md)
        echo "⚠️ Skipping documentation file from secret scan: $f"
        continue
        ;;
    esac
    if [ -f "$f" ]; then
      echo "➡️ gitleaks scanning: $f"
      npx gitleaks detect --source "$f" --verbose --redact || FAIL=1
    fi
  done
  if [ $FAIL -ne 0 ]; then
    echo -e "\n💥 [Pre-Push] PUSH REJECTED: gitleaks detected issues in changed files. Remediate and try again.\n"
    exit 1
  fi
  echo "✅ gitleaks passed on changed files."
  exit 0
fi

echo "⚠️ No scanning tool available (npx/gitleaks). Skipping secret checks."
exit 0
