# SimpleBeacon Enterprise Engine — multi-stage production image
# Builds the Node.js API server + React dashboard assets into a single
# immutable image suitable for air-gapped enterprise deployments.
#
# Build:
#   docker build -t simplebeacon-engine:latest -f Dockerfile.enterprise .
# Run:
#   docker run -p 3000:3000 simplebeacon-engine:latest

# ── Stage 1: Build React dashboard assets ─────────────────────────────────
FROM node:22-alpine AS dashboard-builder
WORKDIR /app

# Copy root package files for workspace resolution
COPY package.json package-lock.json* ./
COPY ai-platform/package.json ./ai-platform/
COPY ai-platform/web/simplebeacon-dashboard/package.json ./ai-platform/web/simplebeacon-dashboard/
COPY packages/simplebeacon-cli/package.json ./packages/simplebeacon-cli/

# Install dashboard dependencies directly (not a root workspace)
# --ignore-scripts skips postinstall hooks that reference files not yet copied
RUN cd ai-platform/web/simplebeacon-dashboard && npm install --ignore-scripts

# Copy dashboard source and build
# Skip tsc -b (type checking) in Docker — vite build uses esbuild which doesn't type-check
# tsc requires @types/node and other hoisted deps not available in isolated install
COPY ai-platform/web/simplebeacon-dashboard ./ai-platform/web/simplebeacon-dashboard
RUN cd ai-platform/web/simplebeacon-dashboard && npx vite build && node scripts/prepare-worker-assets.cjs

# ── Stage 2: Build server ─────────────────────────────────────────────────
FROM node:22-alpine AS server-builder
WORKDIR /app

# Copy root package files
COPY package.json package-lock.json* ./
COPY ai-platform/package.json ./ai-platform/
COPY packages/simplebeacon-cli/package.json ./packages/simplebeacon-cli/

# Install all dependencies (ai-platform is a root workspace)
# --ignore-scripts skips postinstall (verify-eslint-deps.js) which needs source files
RUN npm ci --ignore-scripts --workspace=ai-platform 2>/dev/null || npm install --ignore-scripts --workspace=ai-platform 2>/dev/null || (cd ai-platform && npm install --ignore-scripts)

# Copy server source
COPY ai-platform ./ai-platform
COPY packages/simplebeacon-cli ./packages/simplebeacon-cli

# Verify server syntax
RUN node -c ai-platform/simplebeacon-server.cjs

# ── Stage 3: Production runtime ───────────────────────────────────────────
FROM node:22-alpine AS runtime
WORKDIR /app

# Install tini for proper PID 1 signal handling
RUN apk add --no-cache tini

# Create non-root user
RUN addgroup -S sbgroup && adduser -S sbuser -G sbgroup

# Copy package files and install production dependencies only
# Both ai-platform and coming-soon workspaces are required — the server
# requires coming-soon modules (email, routes, lib) at runtime.
COPY package.json package-lock.json* ./
COPY ai-platform/package.json ./ai-platform/
COPY coming-soon/package.json ./coming-soon/
COPY packages/simplebeacon-cli/package.json ./packages/simplebeacon-cli/
RUN npm ci --omit=dev --ignore-scripts --workspace=ai-platform --workspace=coming-soon 2>/dev/null || npm install --omit=dev --ignore-scripts --workspace=ai-platform --workspace=coming-soon 2>/dev/null || (cd ai-platform && npm install --omit=dev --ignore-scripts && cd ../coming-soon && npm install --omit=dev --ignore-scripts)

# Copy built server code
COPY --from=server-builder /app/ai-platform ./ai-platform
COPY --from=server-builder /app/packages/simplebeacon-cli ./packages/simplebeacon-cli

# Copy built dashboard assets (overwrites dashboard dir with built version)
COPY --from=dashboard-builder /app/ai-platform/web/simplebeacon-dashboard/assets ./ai-platform/web/simplebeacon-dashboard/assets
COPY --from=dashboard-builder /app/ai-platform/web/simplebeacon-dashboard/index.html ./ai-platform/web/simplebeacon-dashboard/

# Copy Modelfiles and manifest for local model setup
COPY coming-soon/public/models ./coming-soon/public/models

# Copy landing pages (marketing site served from coming-soon/public)
COPY coming-soon/public ./coming-soon/public

# Copy coming-soon server modules (email, routes, lib — required by ai-platform server)
COPY coming-soon/services ./coming-soon/services
COPY coming-soon/routes ./coming-soon/routes
COPY coming-soon/lib ./coming-soon/lib
COPY coming-soon/package.json ./coming-soon/package.json

# Copy setup script
COPY ai-platform/scripts/setup-local-model.cjs ./ai-platform/scripts/

# Create data directories with correct ownership
RUN mkdir -p /app/data /app/ai-platform/incoming_user_data /app/ai-platform/processed_reports /app/ai-platform/processed_archive \
    && chown -R sbuser:sbgroup /app

# Switch to non-root user
USER sbuser

# Expose the API port
EXPOSE 3000

# Health check — uses Node.js http module (no curl in alpine)
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode < 400 ? 0 : 1)).on('error', () => process.exit(1))"

# Entrypoint with tini for signal handling
ENTRYPOINT ["/sbin/tini", "--"]

# Start the SimpleBeacon server
CMD ["node", "ai-platform/simplebeacon-server.cjs"]
