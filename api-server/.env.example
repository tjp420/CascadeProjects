# SimpleBeacon API Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

NODE_ENV=production
PORT=10000
PUBLIC_URL=https://api.simplebeacon.com

# License / JWT
SIMPLEBEACON_LICENSE_SECRET=your-jwt-secret-min-32-chars

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_FROM=certificates@simplebeacon.ai

# Database
DATABASE_URL=postgresql://user:pass@host:5432/dbname
REDIS_URL=redis://localhost:6379

# CORS origins (comma-separated)
ALLOWED_ORIGIN=https://simplebeacon.ai,https://simplebeacon.onrender.com
