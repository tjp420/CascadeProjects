{
  "name": "simplebeacon-api",
  "version": "3.2.0",
  "description": "SimpleBeacon API server — backend for file uploads, scan engine, certificate generation, billing, and email queue",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "dev": "nodemon server.cjs",
    "build": "node -c server.cjs && echo 'Server syntax OK'",
    "lint": "npx eslint .",
    "format": "npx prettier --write '**/*.cjs'",
    "quality:check": "npm run build && npm run lint"
  },
  "dependencies": {
    "express": "5.2.1",
    "cors": "2.8.6",
    "helmet": "7.2.0",
    "express-rate-limit": "8.6.1",
    "multer": "1.4.5-lts.2",
    "dotenv": "16.6.1",
    "stripe": "22.3.2",
    "nodemailer": "9.0.3",
    "pg": "8.23.0",
    "redis": "6.2.0",
    "jsonwebtoken": "9.0.3",
    "bcryptjs": "3.0.3",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "nodemon": "3.1.14",
    "eslint": "10.8.1",
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "license": "MIT"
}
