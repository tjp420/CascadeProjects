{
  "name": "cascade-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "ai-platform",
    "ai-platform/packages/*",
    "coming-soon",
    "simplebeacon-vscode-merged"
  ],
  "scripts": {
    "start": "node ai-platform/simplebeacon-server.cjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npx prettier --write \"**/*.{js,cjs,mjs,ts,json,md}\"",
    "quality:check": "npm run quality:check --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "quality:monthly": "cd packages/simplebeacon-cli && node bin/simplebeacon.js scan --path ../.. --gate --full --format json --output .simplebeacon/monthly-quality-report.json && npm audit && cd ../../ai-platform && npm audit && cd ../coming-soon && npm audit",
    "ai:check": "node scripts/ai-check.js",
    "audit:context": "node scripts/audit-context.cjs",
    "audit:context:init": "node scripts/audit-context.cjs --init-prd",
    "sb:hook:pre-commit": "npx simplebeacon scan --gate --fail-on high",
    "diagnose:dashboard": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/diagnose-dashboard.ps1",
    "start:54800": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:PORT=54800; node ai-platform/simplebeacon-server.cjs\""
  },
  "prepare": "husky install",
  "dependencies": {
    "@swc/core": "^1.15.46",
    "archiver": "^8.0.0",
    "dompurify": "^3.4.12",
    "express-rate-limit": "^8.5.2",
    "nodemailer": "^9.0.3",
    "resend": "^3.2.0",
    "stripe": "^22.1.1",
    "tmp": "^0.2.7"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "dotenv": "^16.3.1",
    "helmet": "^7.0.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "playwright": "^1.61.1",
    "vite": "^8.0.16"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "minimatch": "^10.2.2"
  }
}
