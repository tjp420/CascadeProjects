{
  "name": "ai-coding-intelligence-dashboard",
  "version": "1.0.0",
  "description": "AI-powered code analysis and intelligence dashboard for project insights",
  "main": "web/dashboard.html",
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "prepare": "husky install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "jest tests/security",
    "test:security:watch": "jest --config=web/jest.security.config.js --watch",
    "test:security:coverage": "jest --config=web/jest.security.config.js --coverage",
    "security:audit": "npm audit --audit-level=moderate",
    "security:scan": "node scripts/security-scan.js",
    "security:fix": "npm audit fix",
    "build": "npm run lint:check && npm run format:check && npm run test",
    "dev": "npm run lint && npm run format && echo 'Development setup complete'",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "validate": "npm run lint:check && npm run format:check && npm run test:coverage && npm run test:security",
    "dev:setup": "node scripts/enhanced-development-setup.js",
    "dev:validate": "npm run lint && npm run format:check && npm run test && npm run test:security",
    "dev:fix": "npm run lint:fix && npm run format",
    "dev:watch": "npm run test -- --watch",
    "dev:coverage": "npm run test -- --coverage",
    "dev:clean": "rm -rf node_modules coverage dist build .jest-cache && npm install",
    "dev:build": "npm run validate && npm run build",
    "dev:deploy": "npm run build && npm run deploy:production",
    "test:unit": "jest src/__tests__/unit",
    "test:integration": "jest src/__tests__/integration",
    "deploy:vercel": "vercel --prod",
    "deploy:preview": "vercel",
    "deploy:dev": "vercel --env=development"
  },
  "keywords": [
    "ai",
    "code-analysis",
    "dashboard",
    "intelligence",
    "development",
    "metrics",
    "quality"
  ],
  "author": "AI Coding Intelligence Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-security": "^1.7.1",
    "husky": "^8.0.3",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "supertest": "^6.3.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run validate"
    }
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/ai-coding-intelligence-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/ai-coding-intelligence-dashboard/issues"
  },
  "homepage": "https://github.com/your-org/ai-coding-intelligence-dashboard#readme",
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}