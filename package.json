{
  "name": "cascade-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "ai-platform",
    "coming-soon",
    "simplebeacon-vscode-merged"
  ],
  "scripts": {
    "start": "node coming-soon/server.cjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npx prettier --write \"**/*.{js,cjs,mjs,ts,json,md}\"",
    "quality:check": "npm run quality:check --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npx jest --config jest.config.js --coverage --watchAll=false",
    "quality:monthly": "cd packages/simplebeacon-cli && node bin/simplebeacon.js scan --path ../.. --gate --full --format json --output .simplebeacon/monthly-quality-report.json && npm audit && cd ../ai-platform && npm audit && cd ../coming-soon && npm audit",
    "ai:check": "node scripts/ai-check.js"
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "express-rate-limit": "^8.5.2",
    "nodemailer": "^8.0.10",
    "resend": "^3.2.0",
    "stripe": "^22.1.1",
    "tmp": "^0.2.7"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "vite": "^8.0.16"
  }
}
