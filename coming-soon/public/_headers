/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  CDN-Cache-Control: max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin

/downloads/*.vsix
  Cache-Control: public, max-age=300, stale-while-revalidate=60
  CDN-Cache-Control: max-age=300, stale-while-revalidate=60
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/api/*
  Cache-Control: no-store, no-cache, must-revalidate, no-transform
  CDN-Cache-Control: no-store, no-cache
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET,POST,PUT,PATCH,DELETE,OPTIONS
  Access-Control-Allow-Headers: Content-Type,Accept,Authorization,X-Token-Password
  Access-Control-Max-Age: 86400

