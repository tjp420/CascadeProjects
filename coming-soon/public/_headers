/*
  Cache-Control: public, no-transform
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob: ws: wss:;

/*.html
  Cache-Control: public, no-cache, no-transform

/dashboard/__entry
  Cache-Control: public, max-age=0, must-revalidate

/dashboard/*.html
  Cache-Control: public, no-cache, no-store, must-revalidate, no-transform

/dashboard/*
  Cache-Control: public, no-cache, no-store, must-revalidate, no-transform
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
