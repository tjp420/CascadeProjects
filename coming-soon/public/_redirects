# API backend routing — handled exclusively by the Pages Function at
# functions/api/[[path]].js which proxies to Render and adds CORS headers.
# Do NOT add a _redirects proxy rule for /api/* — it intercepts OPTIONS
# preflight before the Function runs, returning incomplete CORS headers.
# The Function handles all methods (GET, POST, PUT, PATCH, DELETE, OPTIONS).

# SPA fallback for dashboard/app — handled by Functions worker (functions/app/[[path]].js)
# The worker passes through static assets (JS, CSS, images) and serves HTML for SPA routes.
# Do NOT add _redirects rules for /app/* or /dashboard/* — they intercept static assets.
