{
  "profile": "standard",
  "scanPaths": ["."],
  "productionPaths": ["."],
  "ignore": [
    "node_modules/**",
    "coverage/**",
    "dist/**",
    "build/**",
    "**/*.test.js",
    "**/*.spec.js",
    "**/*.test.ts",
    "**/*.spec.ts",
    "tests/**",
    "test/**",
    "**/.gitkeep",
    "**/test-output*.txt"
  ],
  "rules": {
    "credentials": {
      "enabled": true,
      "scanProduction": true
    },
    "json-schema": {
      "enabled": true
    },
    "sample-consistency": {
      "enabled": true
    },
    "roadmap": {
      "enabled": false
    },
    "production-leak": {
      "enabled": true,
      "severity": "high"
    },
    "fiction-kpi-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "llm-slop-patterns": {
      "enabled": true,
      "severity": "medium",
      "registryCheck": false
    },
    "agency-handoff-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "eu-ai-act-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "file-naming-patterns": {
      "enabled": false,
      "severity": "medium"
    },
    "jest-baseline": {
      "enabled": false,
      "runTests": false
    }
  },
  "gate": {
    "failOn": ["high"],
    "warnOn": ["medium", "low"]
  },
  "fullDirectoryScan": true,
  "fullDirectoryScanSkipDirs": [
    ".git",
    "node_modules",
    ".simplebeacon"
  ]
}
