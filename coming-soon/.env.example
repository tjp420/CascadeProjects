### SimpleBeacon (coming-soon) environment example
# Copy this file to `coming-soon/.env` and fill with real values for local testing.

# Core secrets (do NOT use these in production)
SIMPLEBEACON_LICENSE_SECRET=insecure-dev-secret-change-me
JWT_SECRET=simplebeacon-insecure-dev-jwt-secret-do-not-use-in-production
JWT_REFRESH_SECRET=simplebeacon-insecure-dev-refresh-secret-do-not-use-in-production
PUBLIC_URL=http://localhost:3000

# Billing / Stripe (use Stripe test keys for local testing)
# Enable monetization in dev by setting SIMPLEBEACON_MONETIZATION_ENABLED=true
SIMPLEBEACON_MONETIZATION_ENABLED=true
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# Price IDs (replace with your Stripe test Price IDs)
STRIPE_PRICE_ID_STARTUP_MONTHLY=price_XXXXXXXXXXXXX
STRIPE_PRICE_ID_STARTUP_YEARLY=price_XXXXXXXXXXXXX
STRIPE_PRICE_ID_TEAM_MONTHLY=price_XXXXXXXXXXXXX
STRIPE_PRICE_ID_TEAM_YEARLY=price_XXXXXXXXXXXXX

# Optional: Cloudflare beacon token (only used in production when set)
CF_BEACON_TOKEN=
# SimpleBeacon Landing Page Environment Variables
# Copy this file to .env and fill in your values
# NOTE: .env uses localhost defaults for local development.
#       .env.example is a copy-paste template with safe defaults.
#       Production overrides are noted inline.

# Public URL for generated certificate links (set to your production domain on Render)
# Production: https://simplebeacon.ai
PUBLIC_URL=http://localhost:3001

# Server port (default: 3001)
PORT=3001

# License secret for token generation (change in production!)
SIMPLEBEACON_LICENSE_SECRET=your-secret-here

# Email (Resend) — required for sandbox tokens, checkout receipts, certificates
# 1. https://resend.com → Domains → add simplebeacon.ai → add DNS records in Cloudflare
# 2. API Keys → create key (re_...)
# 3. Render dashboard → Environment → RESEND_API_KEY + RESEND_FROM → redeploy
RESEND_API_KEY=
RESEND_FROM=certificates@simplebeacon.ai

# SMTP fallback — Zoho Mail (Canadian data center)
# Used when Resend API fails, and for contact form delivery.
# Generate an app-specific password in Zoho Mail → Settings → Mail Accounts → SMTP/IMAP.
SMTP_HOST=smtp.zohocloud.ca
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=                          # trevor@simplebeacon.ai (set in .env, not committed)
SMTP_PASS=                          # Zoho app-specific password (set in .env, not committed)
SMTP_FROM=certificates@simplebeacon.ai

# Contact form — inbox where /api/contact form submissions are delivered
CONTACT_NOTIFY_EMAIL=support@simplebeacon.ai

# Customer support email (used by chatbot API appeal process)
SUPPORT_EMAIL=support@simplebeacon.ai

# Stripe dispute alert recipient
DISPUTE_ALERT_EMAIL=support@simplebeacon.ai

# Production CORS origin (set to your production domain)
# Production: https://simplebeacon.ai
ALLOWED_ORIGIN=http://localhost:3001

# Node environment (development | production)
NODE_ENV=development

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_TEAMS_MONTHLY=price_...
STRIPE_PRICE_ID_TEAMS_ANNUAL=price_...
STRIPE_PRICE_ID_EXECUTIVE_CLEARANCE=price_...
STRIPE_PRICE_ID_INSTANT_REPORT=price_...
STRIPE_PRICE_ID_EU_AI_ACT_SPRINT=price_...
STRIPE_PRICE_ID_CONTINUOUS_SHIELD=price_...
STRIPE_PRICE_ID_RUNTIME_SHIELD=price_...

# Stripe Checkout Links (optional — used by /api/pricing endpoint)
STRIPE_LINK_INSTANT=
STRIPE_LINK_EXECUTIVE=
STRIPE_LINK_EU_SPRINT=

# Landing page flag (set to "true" in production)
SIMPLEBEACON_LANDING=true

# Full app URL (same as PUBLIC_URL in production)
SIMPLEBEACON_APP_URL=http://localhost:3001
