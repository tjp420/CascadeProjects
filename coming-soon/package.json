{
  "name": "simplebeacon-coming-soon",
  "version": "1.0.0",
  "description": "SimpleBeacon landing page with integrated backend",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "dev": "node server.cjs",
    "test": "node --test test/*.test.cjs",
    "build": "tsc",
    "lint": "node -c server.cjs",
    "format": "npx prettier --write .",
    "analyze": "node analyze-directory.js",
    "analyze:full": "node analyze-directory.js --output .simplebeacon/analyzer-report.json",
    "quality:check": "npx simplebeacon scan . --gate --offline"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "vite": "^8.0.16"
  }
}
