{
  "name": "simplebeacon-local-agent",
  "version": "1.0.0",
  "description": "SimpleBeacon native scanning agent that bridges the hosted dashboard to local filesystem paths.",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js",
    "build:win": "pkg agent.js --targets node22-win-x64 --output simplebeacon-scanner.exe",
    "build:mac": "pkg agent.js --targets node22-macos-x64 --output simplebeacon-scanner-macos",
    "build:linux": "pkg agent.js --targets node22-linux-x64 --output simplebeacon-scanner-linux"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.15.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
