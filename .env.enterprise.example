# SimpleBeacon Enterprise Environment Configuration
#
# Copy this file to .env.enterprise and fill in the values before running:
#   docker compose -f docker-compose.enterprise.yml --env-file .env.enterprise up -d
#
# All secrets should be generated with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# See docs/PRODUCTION_ENV_VARS.md for the complete variable reference.

# ── Security & Auth (REQUIRED — generate strong random values) ─────────────
JWT_SECRET=
SIMPLEBEACON_LICENSE_SECRET=
DASHBOARD_VAULT_PASSWORD=
REPORT_SIGNING_KEY=

# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string — points to the simplebeacon-db container
# Change POSTGRES_PASSWORD from the default for production deployments
# NOTE: The password below is a development placeholder only — never use in production
POSTGRES_PASSWORD=simplebeacon_dev
DATABASE_URL=postgresql://simplebeacon_user:simplebeacon_dev@simplebeacon-db:5432/simplebeacon

# ── LLM / Ollama ───────────────────────────────────────────────────────────
# Model ID — must match a model in coming-soon/public/models/manifest.json
OLLAMA_MODEL=unbreakable-oracle:latest
# Context window — must match the Modelfile's PARAMETER num_ctx
# Options: 4096 (llama3.2), 8192 (unbreakable-oracle), 32768 (mistral, qwen2.5-coder)
OLLAMA_NUM_CTX=8192

# ── Memory Budget Profile ──────────────────────────────────────────────────
# Selects quantization and context window based on available hardware.
# Run scripts/detect-hardware-profile.sh to auto-detect the best profile.
#
# Profiles (see coming-soon/public/models/memory-profiles.json):
#   minimal  — CPU-only, 8GB RAM, Q4_K_M, 2048 ctx, ~4.4 GB RAM
#   balanced — Auto GPU, 16GB RAM, 6GB VRAM, Q4_K_M, 4096 ctx, ~5.5 GB total [default]
#   maximum  — Full GPU, 32GB RAM, 12GB VRAM, Q5_K_M, 8192 ctx, ~6.5 GB total
OLLAMA_MEMORY_PROFILE=balanced

# ── GPU Offload ────────────────────────────────────────────────────────────
# Number of transformer layers to offload to GPU.
# -1 = auto-detect (Ollama offloads as many as fit in VRAM) [default]
#  0 = CPU only (for machines without a GPU — use with minimal profile)
#  999 = maximum GPU offload (force all layers to GPU — use with maximum profile)
OLLAMA_NUM_GPU=-1

# ── Inference Tuning (optional — defaults shown) ───────────────────────────
# Number of CPU threads for prompt processing (0 = auto-detect)
OLLAMA_NUM_THREAD=0

# ── CORS & URLs ────────────────────────────────────────────────────────────
# Set to the URL where the dashboard will be accessed
ALLOWED_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:3000

# ── Ports (optional — defaults shown) ──────────────────────────────────────
ENGINE_PORT=3000
OLLAMA_PORT=11434
DB_PORT=5432

# ── Email (optional — leave blank to disable outbound email) ───────────────
# Configure with Zoho Mail or Resend for email functionality
RESEND_API_KEY=
RESEND_FROM=admin@simplebeacon.ai
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=admin@simplebeacon.ai
CONTACT_NOTIFY_EMAIL=admin@simplebeacon.ai

# ── Stripe Billing (optional — leave blank to disable billing) ─────────────
# Required for self-service purchases and subscription management
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cloud AI Providers (optional — leave blank for offline-only mode) ──────
# If set, the chatbot will use these as fallbacks when Ollama is unavailable
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
