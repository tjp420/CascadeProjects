#!/bin/sh
# ai-agent pre-commit hook
# 1. Syntax-check all staged JS/CJS files
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|cjs)$' || true)
for f in $STAGED; do
    if [ -f "$f" ]; then
        node -c "$f" || { echo "Syntax error in $f"; exit 1; }
    fi
done
# 2. Run SimpleBeacon gate scan (fail on high/critical severity)
npx simplebeacon scan --gate --format json || {
    echo "SimpleBeacon gate scan failed. Fix blocking issues before committing."
    exit 1
}

# 3. Run test suite
npm test || exit 1
