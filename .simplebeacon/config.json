{
  "profile": "eu-ai-act",
  "allowedAnalysisRoots": [
    "C:\\Users\\Trevor\\CascadeProjects",
    "C:\\Users\\Trevor\\CascadeProjects\\google-earthenterprise",
    "C:\\Users\\Trevor\\CascadeProjects_BACKUP_20260521",
    "C:\\Users\\Trevor\\CascadeProjects_BACKUP_20260521\\google-earthenterprise",
    "C:\\Users\\Trevor\\AI-Guardrail-system",
    "C:\\Users\\Trevor\\CascadeProjects\\ai-platform",
    "C:\\Users\\Trevor\\CascadeProjects\\ai-platform\\web",
    "C:\\Users\\Trevor\\CascadeProjects\\ai-platform\\web\\coming-soon",
    "C:\\Users\\Trevor\\CascadeProjects\\ai-platform\\server",
    "J:\\AI project backup",
    "C:\\tmp"
  ],
  "scanPaths": [
    "."
  ],
  "productionPaths": [
    "src/",
    "lib/",
    "server/",
    "web/",
    "routes/",
    "api/",
    "middleware/",
    "components/",
    "views/",
    "js/",
    "css/",
    "packages/"
  ],
  "sampleDir": "data",
  "consistencyAnchorSamples": [],
  "ignore": [
    "node_modules/**",
    "coverage/**",
    "dist/**",
    "build/**",
    "**/*.test.js",
    "**/*.spec.js",
    "**/*.test.ts",
    "**/*.spec.ts",
    "tests/**",
    "test/**",
    "coming-soon-dev/**",
    "simplebeacon-frameworkless/**",
    "sales/**",
    "marketing/**",
    "logs/**",
    "github-action/**",
    "browser-local/**",
    ".vscode/**",
    "report.json",
    "cli-test-report*.json",
    "test-output.txt"
  ],
  "rules": {
    "credentials": {
      "enabled": true,
      "scanProduction": true
    },
    "json-schema": {
      "enabled": true
    },
    "sample-consistency": {
      "enabled": true
    },
    "roadmap": {
      "enabled": true
    },
    "production-leak": {
      "enabled": true,
      "severity": "high"
    },
    "fiction-kpi-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "llm-slop-patterns": {
      "enabled": true,
      "severity": "medium",
      "registryCheck": false
    },
    "agency-handoff-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "eu-ai-act-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "jest-baseline": {
      "enabled": false,
      "runTests": false
    },
    "token-bleed-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "architecture-drift-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "performance": {
      "enabled": true,
      "severity": "low",
      "reason": "Detect synchronous file ops and performance anti-patterns"
    },
    "type-safety": {
      "enabled": true,
      "severity": "medium",
      "reason": "Detect excessive any types and missing type annotations"
    },
    "ai-residue": {
      "enabled": true,
      "severity": "low",
      "reason": "Detect leftover AI-generated stubs and placeholder code"
    },
    "config-drift": {
      "enabled": true,
      "severity": "medium",
      "reason": "Detect hardcoded URLs, secrets, and env var drift"
    },
    "security-headers": {
      "enabled": true,
      "severity": "low",
      "reason": "Detect missing security headers in HTTP responses"
    },
    "quality": {
      "enabled": true,
      "severity": "low",
      "reason": "Detect debug artifacts, TODOs, and code quality issues"
    },
    "file-reduction": {
      "enabled": false,
      "dryRun": true,
      "suppressions": [
        { "type": "env-inconsistency", "path": "ai-platform/.env.v1-internal", "reason": "Intentional dev profile with documented differences from production" },
        { "type": "version-drift", "path": "ai-platform/package.json", "reason": "Standard npm semver ranges; drift vs lockfile is expected" },
        { "type": "duplicate-config-type", "path": "ai-platform/vite.config.js", "reason": "Single vite config with no actual duplicate keys" },
        { "type": "orphaned-export", "path": "simplebeacon-vscode-merged/src/", "reason": "VS Code extension public API exports — used dynamically by extension host" },
        { "type": "dead-export", "path": "simplebeacon-vscode-merged/src/", "reason": "VS Code extension public API exports — used dynamically by extension host" },
        { "type": "version-drift", "path": "simplebeacon-vscode/package.json", "reason": "Legacy backup extension — separate version from active merged extension" },
        { "type": "version-drift", "path": "ai-platform/simplebeacon-vscode/package.json", "reason": "Platform-specific extension wrapper — separate version" },
        { "type": "version-drift", "path": "packages/simplebeacon-cli/package.json", "reason": "CLI tool — separate version from VS Code extension" },
        { "type": "build-artifact", "path": "simplebeacon-vscode/out/", "reason": "Compiled extension output — generated by build process" },
        { "type": "build-artifact", "path": "simplebeacon-vscode-OLD/out/", "reason": "Legacy compiled output — to be removed" },
        { "type": "duplicate-data", "path": "simplebeacon-vscode/", "reason": "Legacy backup extension — duplicate configs expected" },
        { "type": "duplicate-data", "path": "simplebeacon-vscode-OLD/", "reason": "Legacy backup extension — duplicate configs expected" },
        { "type": "synchronous-file-operation", "path": "coming-soon/build-public.js", "reason": "Build script — fs.mkdirSync is intentional for deployment" },
        { "type": "sensitive-data-in-logs", "path": "coming-soon/routes/admin.cjs", "reason": "Logs missing env var name, not the secret value" },
        { "type": "sensitive-data-in-logs", "path": "coming-soon/routes/token-validate.cjs", "reason": "Standard error logging, no secrets exposed" },
        { "type": "unhandled-promise", "path": "simplebeacon-vscode/src/extension.ts", "reason": "Legacy backup extension — promise chain pattern with catch handler" },
        { "type": "type-safety-gap", "path": "simplebeacon-vscode/src/codeMapProvider.ts", "reason": "Legacy backup extension — any types at API boundaries are standard" },
        { "type": "type-safety-gap", "path": "simplebeacon-vscode/src/extension.ts", "reason": "Legacy backup extension — any types at API boundaries are standard" }
      ]
    }
  },
  "gate": {
    "failOn": [
      "high"
    ],
    "warnOn": [
      "medium",
      "low"
    ]
  }
}
