{
  "profile": "eu-ai-act",
  "scanPaths": [
    "."
  ],
  "productionPaths": [
    "."
  ],
  "sampleDir": "fixtures",
  "consistencyAnchorSamples": [],
  "ignore": [
    "**/*.spec.js",
    "**/*.spec.ts",
    "**/*.test.js",
    "**/*.test.ts",
    "**/.gitkeep",
    "**/test-output*.txt",
    "ai-agent/**",
    "ai-platform/**",
    "ai-tools/**",
    "backups/**",
    "build/**",
    "coming-soon/**",
    "coverage/**",
    "deployments/**",
    "dist/**",
    "logs/**",
    "node_modules/**",
    "packages/**",
    "packages/simplebeacon-cli/**",
    "simplebeacon-frameworkless/**",
    "simplebeacon-rule-tests/**",
    "test/**",
    "tests/**"
  ],
  "rules": {
    "credentials": {
      "enabled": true,
      "scanProduction": true
    },
    "json-schema": {
      "enabled": true
    },
    "sample-consistency": {
      "enabled": true
    },
    "roadmap": {
      "enabled": true
    },
    "production-leak": {
      "enabled": true,
      "severity": "high"
    },
    "fiction-kpi-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "llm-slop-patterns": {
      "enabled": true,
      "severity": "medium",
      "registryCheck": false
    },
    "agency-handoff-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "eu-ai-act-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "file-naming-patterns": {
      "enabled": false,
      "severity": "medium"
    },
    "jest-baseline": {
      "enabled": false,
      "runTests": false
    },
    "token-bleed-patterns": {
      "enabled": false,
      "severity": "medium"
    },
    "architecture-drift-patterns": {
      "enabled": false,
      "severity": "high"
    },
    "python-ast-patterns": {
      "enabled": false,
      "severity": "medium"
    },
    "javascript-ast-patterns": {
      "enabled": false,
      "severity": "medium"
    }
  },
  "gate": {
    "failOn": [
      "high"
    ],
    "warnOn": [
      "medium",
      "low"
    ]
  },
  "sourceCodeScanPaths": [
    "."
  ],
  "fullDirectoryScan": false,
  "fullDirectoryScanSkipDirs": [
    ".git",
    ".github-sync",
    "ai-agent",
    "ai-platform",
    "ai-tools",
    "backups",
    "coming-soon",
    "deployments",
    "github-cache",
    "logs",
    "node_modules",
    "packages",
    "simplebeacon-frameworkless",
    "simplebeacon-rule-tests"
  ]
}