  "rules": {
    "credentials": {
      "enabled": true,
      "scanProduction": true,
      "ignoreGlobs": [
        "**/coming-soon/archive/**",
        "**/simplebeacon-rule-tests/**",
        "**/ai-platform/tests/**",
        "**/.github/workflows/simplebeacon-action-stress-test.yml",
        "**/authService.test.js",
        "**/ai-slop-cop-pro-token.txt",
        "**/coming-soon/public/reports/**",
        "**/knip-report.txt",
        "**/code-hygiene-certificate.cjs",
        "**/ai-platform/package-lock.json",
        "**/ai-platform/local-agent/package-lock.json",
        "**/server-integration.test.js",
        "**/secret-config.test.js",
        "**/auth-integration.test.js",
        "**/file-quality-heuristics.test.js",
        "**/snippetDiagnostic.js",
        "**/vscode-remediation-payload.json"
      ]
    },
    "json-schema": {
      "enabled": true
    },
    "sample-consistency": {
      "enabled": true
    },
    "roadmap": {
      "enabled": true
    },
    "production-leak": {
      "enabled": true,
      "severity": "high"
    },
    "fiction-kpi-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "llm-slop-patterns": {
      "enabled": true,
      "severity": "medium",
      "registryCheck": false
    },
    "agency-handoff-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "eu-ai-act-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "jest-baseline": {
      "enabled": false,
      "runTests": false
    },
    "token-bleed-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "architecture-drift-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "performance": {
      "enabled": true,
      "severity": "low",
      "reason": "Detect synchronous file ops and performance anti-patterns"
    },
    "type-safety": {
      "enabled": true,
      "severity": "medium",
      "reason": "Detect excessive any types and missing type annotations"
    },
    "ai-residue": {
      "enabled": true,
      "severity": "low",
      "reason": "Detect leftover AI-generated stubs and placeholder code"
    },
    "config-drift": {
      "enabled": true,
      "severity": "medium",
      "reason": "Detect hardcoded URLs, secrets, and env var drift"
    },
    "security-headers": {
      "enabled": true,
      "severity": "low",
      "reason": "Detect missing security headers in HTTP responses"
    },
    "quality": {
      "enabled": true,
      "severity": "low",
      "reason": "Detect debug artifacts, TODOs, and code quality issues"
    },
    "dead-code": {
      "enabled": false,
      "reason": "orphaned-export and dead-export findings are false positives for ES2018 dashboard component library — exports are consumed by external consumers, not internally cross-referenced"
    },
    "memory-leak": {
      "enabled": false,
      "reason": "Intentional event listeners and intervals in long-running server processes"
    },
    "build-artifact": {
      "enabled": false,
      "reason": "Logs, node_modules, and test output are generated artifacts not source code"
    },
    "hardcoded-url": {
      "enabled": false,
      "reason": "CSP localhost development origins are intentional and env-overrideable"
    },
    "file-reduction": {
      "enabled": false,
      "dryRun": true,
      "suppressions": [
        {
          "type": "env-inconsistency",
          "path": "ai-platform/.env.v1-internal",
          "reason": "Intentional dev profile with documented differences from production"
        },
        {
          "type": "version-drift",
          "path": "ai-platform/package.json",
          "reason": "Standard npm semver ranges; drift vs lockfile is expected"
        },
        {
          "type": "duplicate-config-type",
          "path": "ai-platform/vite.config.js",
          "reason": "Single vite config with no actual duplicate keys"
        },
        {
          "type": "orphaned-export",
          "path": "simplebeacon-vscode-merged/src/",
          "reason": "VS Code extension public API exports — used dynamically by extension host"
        },
        {
          "type": "dead-export",
          "path": "simplebeacon-vscode-merged/src/",
          "reason": "VS Code extension public API exports — used dynamically by extension host"
        },
        {
          "type": "version-drift",
          "path": "simplebeacon-vscode/package.json",
          "reason": "Legacy backup extension — separate version from active merged extension"
        },
        {
          "type": "version-drift",
          "path": "ai-platform/simplebeacon-vscode/package.json",
          "reason": "Platform-specific extension wrapper — separate version"
        },
        {
          "type": "version-drift",
          "path": "packages/simplebeacon-cli/package.json",
          "reason": "CLI tool — separate version from VS Code extension"
        },
        {
          "type": "build-artifact",
          "path": "simplebeacon-vscode/out/",
          "reason": "Compiled extension output — generated by build process"
        },
        {
          "type": "build-artifact",
          "path": "simplebeacon-vscode-OLD/out/",
          "reason": "Legacy compiled output — to be removed"
        },
        {
          "type": "duplicate-data",
          "path": "simplebeacon-vscode/",
          "reason": "Legacy backup extension — duplicate configs expected"
        },
        {
          "type": "duplicate-data",
          "path": "simplebeacon-vscode-OLD/",
          "reason": "Legacy backup extension — duplicate configs expected"
        },
        {
          "type": "duplicate-data",
          "path": "simplebeacon-vscode-merged/src/rules/llm-slop-catalog.json",
          "reason": "Generated copy of CLI rule catalog — single source of truth in packages/simplebeacon-cli"
        },
        {
          "type": "synchronous-file-operation",
          "path": "coming-soon/build-public.js",
          "reason": "Build script — fs.mkdirSync is intentional for deployment"
        },
        {
          "type": "sensitive-data-in-logs",
          "path": "coming-soon/routes/admin.cjs",
          "reason": "Logs missing env var name, not the secret value"
        },
        {
          "type": "sensitive-data-in-logs",
          "path": "coming-soon/routes/token-validate.cjs",
          "reason": "Standard error logging, no secrets exposed"
        },
        {
          "type": "unhandled-promise",
          "path": "simplebeacon-vscode/src/extension.ts",
          "reason": "Legacy backup extension — promise chain pattern with catch handler"
        },
        {
          "type": "type-safety-gap",
          "path": "simplebeacon-vscode/src/codeMapProvider.ts",
          "reason": "Legacy backup extension — any types at API boundaries are standard"
        },
        {
          "type": "type-safety-gap",
          "path": "simplebeacon-vscode/src/extension.ts",
          "reason": "Legacy backup extension — any types at API boundaries are standard"
        }
      ]
    }
  },
  "gate": {
    "failOn": [
      "high"
    ],
    "warnOn": [
      "medium",
      "low"
    ]
  },
  "fullDirectoryScan": true,
  "fullDirectoryScanMaxFiles": 100000,
  "fullDirectoryScanSkipDirs": [
    ".git",
    "github-cache",
    ".simplebeacon",
    ".vscode-test",
    "node_modules",
    "out",
    "releases",
    ".vsix-patch-temp",
    "dist",
    "build",
    ".next",
    ".cache",
    "coverage",
    "simplebeacon-vscode-merged",
    "ai-tools",
    "ai-agent",
    "coming-soon"
  ]
