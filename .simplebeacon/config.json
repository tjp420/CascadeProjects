    },
    "production-leak": {
      "enabled": true,
      "severity": "high",
      "ignoreGlobs": [
        "ai-platform/web/simplebeacon-dashboard/js-es2018/utils/sample-report.js",
        "**/secret-scanner.cjs"
      ]
    },
    "json-schema": {
      "enabled": true,
      "ignoreGlobs": [
        "**/tsconfig.json",
        "**/jsconfig.json",
        "**/tsconfig.init.json"
      ]
    },
    "sample-consistency": {
      "enabled": true
    },
    "roadmap": {
      "enabled": true
    },
    "fiction-kpi-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "llm-slop-patterns": {
      "enabled": true,
      "severity": "medium",
      "registryCheck": false,
      "ignoreGlobs": [
        "packages/simplebeacon-cli/src/agent-pda/cross-project-learner.js",
        "packages/simplebeacon-cli/PUBLISH.md",
        "coming-soon/content/demo-gif-script.md",
        "coming-soon/public/content/demo-gif-script.md"
      ]
    },
    "agency-handoff-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "eu-ai-act-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "jest-baseline": {
      "enabled": true,
      "runTests": true
    },
    "token-bleed-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "architecture-drift-patterns": {
      "enabled": true,
      "severity": "medium"
    },
    "performance": {
      "enabled": true,
      "severity": "low",
      "reason": "Detect synchronous file ops and performance anti-patterns"
    },
    "type-safety": {
      "enabled": true,
      "severity": "medium",
      "reason": "Detect excessive any types and missing type annotations"
    },
    "ai-residue": {
      "enabled": true,
      "severity": "low",
      "reason": "Detect leftover AI-generated stubs and placeholder code"
    },
    "config-drift": {
      "enabled": true,
      "severity": "medium",
      "reason": "Detect hardcoded URLs, secrets, and env var drift",
      "ignoreGlobs": [
        "ai-platform/local-agent/package.json",
        "local-agent/package.json",
        "simplebeacon-desktop/package.json",
        "packages/simplebeacon-cli/package.json"
      ]
    },
    "security-headers": {
      "enabled": true,
      "severity": "low",
      "reason": "Detect missing security headers in HTTP responses",
      "ignoreGlobs": [
        "ai-platform/src/api/enterprise-onboarding.cjs"
      ]
    },
    "quality": {
      "enabled": true,
      "severity": "low",
      "reason": "Detect debug artifacts, TODOs, and code quality issues"
    },
    "dead-code": {
      "enabled": false,
      "reason": "orphaned-export and dead-export findings are false positives for ES2018 dashboard component library — exports are consumed by external consumers, not internally cross-referenced"
    },
    "memory-leak": {
      "enabled": false,
      "reason": "Intentional event listeners and intervals in long-running server processes"
    },
    "build-artifact": {
      "enabled": false,
      "reason": "Logs, node_modules, and test output are generated artifacts not source code"
    },
    "hardcoded-url": {
      "enabled": false,
      "reason": "CSP localhost development origins are intentional and env-overrideable"
    },
    "file-reduction": {
      "enabled": false,
      "dryRun": true,
      "suppressions": [
        {
          "type": "env-inconsistency",
          "path": "ai-platform/.env.v1-internal",
          "reason": "Intentional dev profile with documented differences from production"
        },
        {
          "type": "version-drift",
          "path": "ai-platform/package.json",
          "reason": "Standard npm semver ranges; drift vs lockfile is expected"
        },
        {
          "type": "duplicate-config-type",
          "path": "ai-platform/vite.config.js",
          "reason": "Single vite config with no actual duplicate keys"
        },
        {
          "type": "orphaned-export",
          "path": "simplebeacon-vscode-merged/src/",
          "reason": "VS Code extension public API exports — used dynamically by extension host"
        },
        {
          "type": "dead-export",
          "path": "simplebeacon-vscode-merged/src/",
          "reason": "VS Code extension public API exports — used dynamically by extension host"
        },
        {
          "type": "version-drift",
          "path": "simplebeacon-vscode/package.json",
          "reason": "Legacy backup extension — separate version from active merged extension"
        },
        {
          "type": "version-drift",
          "path": "ai-platform/simplebeacon-vscode/package.json",
          "reason": "Platform-specific extension wrapper — separate version"
        },
        {
          "type": "version-drift",
          "path": "packages/simplebeacon-cli/package.json",
          "reason": "CLI tool — separate version from VS Code extension"
        },
        {
          "type": "build-artifact",
          "path": "simplebeacon-vscode/out/",
          "reason": "Compiled extension output — generated by build process"
        },
        {
          "type": "build-artifact",
          "path": "simplebeacon-vscode-OLD/out/",
          "reason": "Legacy compiled output — to be removed"
        },
        {
          "type": "duplicate-data",
          "path": "simplebeacon-vscode/",
          "reason": "Legacy backup extension — duplicate configs expected"
        },
        {
          "type": "duplicate-data",
          "path": "simplebeacon-vscode-OLD/",
          "reason": "Legacy backup extension — duplicate configs expected"
        },
        {
          "type": "duplicate-data",
          "path": "simplebeacon-vscode-merged/src/rules/llm-slop-catalog.json",
          "reason": "Generated copy of CLI rule catalog — single source of truth in packages/simplebeacon-cli"
        },
        {
          "type": "duplicate-data",
          "path": "coming-soon/public/dashboard/js/demo/demo-audit.json",
          "reason": "Build artifact copy from build-public.js — single source of truth in ai-platform/web/simplebeacon-dashboard/js/demo/"
        },
        {
          "type": "duplicate-data",
          "path": "coming-soon/public/dashboard/js/demo/demo-report.json",
          "reason": "Build artifact copy from build-public.js — single source of truth in ai-platform/web/simplebeacon-dashboard/js/demo/"
        },
        {
          "type": "duplicate-data",
          "path": "simplebeacon-vscode-merged/dashboard-web/js/demo/demo-audit.json",
          "reason": "Synced copy from sync-dashboard-web.cjs — single source of truth in ai-platform/web/simplebeacon-dashboard/js/demo/"
        },
        {
          "type": "duplicate-data",
          "path": "simplebeacon-vscode-merged/dashboard-web/js/demo/demo-report.json",
          "reason": "Synced copy from sync-dashboard-web.cjs — single source of truth in ai-platform/web/simplebeacon-dashboard/js/demo/"
        },
        {
          "type": "synchronous-file-operation",
          "path": "coming-soon/build-public.js",
          "reason": "Build script — fs.mkdirSync is intentional for deployment"
        },
        {
          "type": "sensitive-data-in-logs",
          "path": "coming-soon/routes/admin.cjs",
          "reason": "Logs missing env var name, not the secret value"
        },
        {
          "type": "sensitive-data-in-logs",
          "path": "coming-soon/routes/token-validate.cjs",
          "reason": "Standard error logging, no secrets exposed"
        },
        {
          "type": "unhandled-promise",
          "path": "simplebeacon-vscode/src/extension.ts",
          "reason": "Legacy backup extension — promise chain pattern with catch handler"
        },
        {
          "type": "missing-rate-limit",
          "path": "ai-platform/src/api/enterprise-onboarding.cjs",
          "reason": "Endpoints are rate-limited via express-rate-limit; scanner false-positive on aggregated route patterns"
        },
        {
          "type": "unhandled-promise",
          "path": "ai-platform/server/lib/hsm-vault.cjs",
          "reason": "Promise chains are wrapped with timeouts and are awaited by callers; mark as accepted"
        },
        {
          "type": "unhandled-promise",
          "path": "ai-platform/server/lib/stripe-event-store.cjs",
          "reason": "File-based event write returns promises that are awaited by callers; mark as accepted"
        },
        {
          "type": "prototype-pollution",
          "path": "ai-platform/web/simplebeacon-dashboard/assets/vendor-charts-*.js",
          "reason": "Third-party vendor bundle; accepted vendor artifact"
        },
        {
          "type": "prototype-pollution",
          "path": "ai-platform/web/simplebeacon-dashboard/assets/vendor-radix-*.js",
          "reason": "Third-party vendor bundle; accepted vendor artifact"
        },
        {
          "type": "insecure-random",
          "path": "ai-platform/web/simplebeacon-dashboard/assets/localAgentService-*.js",
          "reason": "Minified vendor bundle uses Math.random for non-crypto purposes in UI assets"
        },
        {
          "type": "insecure-random",
          "path": "coming-soon/public/dashboard/assets/localAgentService-*.js",
          "reason": "Minified vendor bundle uses Math.random for non-crypto purposes in UI assets (mirror)"
        },
        {
          "type": "type-safety-gap",
          "path": "simplebeacon-vscode/src/codeMapProvider.ts",
          "reason": "Legacy backup extension — any types at API boundaries are standard"
        },
        {
          "type": "type-safety-gap",
          "path": "simplebeacon-vscode/src/extension.ts",
          "reason": "Legacy backup extension — any types at API boundaries are standard"
        },
        {
          "type": "markdown-fence-leak",
          "path": "packages/simplebeacon-cli/src/agent-pda/cross-project-learner.js",
          "reason": "generateReport() intentionally outputs markdown fences — false positive on markdown generator"
        },
        {
          "type": "unpinned-dependency",
          "path": "ai-platform/local-agent/package.json",
          "reason": "Standard npm ^ ranges — lockfile provides reproducibility, ^ allows security patches"
        },
        {
          "type": "unpinned-dependency",
          "path": "local-agent/package.json",
          "reason": "Standard npm ^ ranges — lockfile provides reproducibility, ^ allows security patches"
        },
        {
          "type": "unpinned-dependency",
          "path": "simplebeacon-desktop/package.json",
          "reason": "Standard npm ^ ranges — lockfile provides reproducibility, ^ allows security patches"
        },
        {
          "type": "unpinned-dependency",
          "path": "packages/simplebeacon-cli/package.json",
          "reason": "Published npm package — pinning forces exact versions on downstream consumers; lockfile provides reproducibility"
        }
      ]
    }
  },
