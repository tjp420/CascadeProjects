{
  "profile": "gamedev",
  "projectName": "R3DLighting",
  "scanPaths": ["."],
  "productionPaths": ["."],
  "ignore": [
    "**/*.log",
    "**/__pycache__/**",
    "build_temp/**",
    "Backup/**",
    "**/*_DUPLICATE.zs",
    "**/*_OLD.zs",
    "**/*.corrupt",
    "**/*.clean",
    "**/*_backup.zs"
  ],
  "gzdoom": {
    "cvarPrefix": "r3d_",
    "companionMod": "R3DOptions"
  },
  "rules": {
    "gzdoom-integrity-patterns": {
      "enabled": true,
      "respectIncludes": true,
      "severity": "high"
    }
  },
  "gate": {
    "enabled": true,
    "failOn": ["high"]
  }
}
