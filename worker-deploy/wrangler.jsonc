{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simplebeacon-dashboard-v2",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-18",
  "routes": [
    {
      "pattern": "simplebeacon.ai/*",
      "zone_name": "simplebeacon.ai"
    },
    {
      "pattern": "www.simplebeacon.ai/*",
      "zone_name": "simplebeacon.ai"
    }
  ],
  "assets": {
    "directory": "../coming-soon/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "API_BACKEND": "https://cascadeprojects-yzzd.onrender.com"
  }
}
