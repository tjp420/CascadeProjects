# SimpleBeacon Ollama Intelligence Service — pre-baked with code analysis models
# Builds an Ollama image with SimpleBeacon's custom Modelfiles and system prompts
# pre-loaded. Designed for air-gapped deployments where `ollama pull` is unavailable.
#
# Build:
#   docker build -t simplebeacon-ollama:latest -f Dockerfile.ollama .
# Run:
#   docker run -p 11434:11434 --gpus all simplebeacon-ollama:latest

FROM ollama/ollama:latest

# Label for identification
LABEL org.opencontainers.image.title="SimpleBeacon Ollama Intelligence"
LABEL org.opencontainers.image.description="Ollama with SimpleBeacon's code analysis Modelfiles pre-baked"
LABEL org.opencontainers.image.source="https://github.com/tjp420/CascadeProjects"

# Create directories
RUN mkdir -p /models /scripts

# Copy Modelfiles and manifest
COPY coming-soon/public/models/Modelfile /models/Modelfile
COPY coming-soon/public/models/Modelfile.llama32 /models/Modelfile.llama32
COPY coming-soon/public/models/Modelfile.mistral /models/Modelfile.mistral
COPY coming-soon/public/models/Modelfile.qwen25-coder /models/Modelfile.qwen25-coder
COPY coming-soon/public/models/manifest.json /models/manifest.json

# Copy the init script from the project
COPY scripts/init-models.sh ./scripts/init-models.sh
RUN chmod +x ./scripts/init-models.sh

# Expose Ollama API port
EXPOSE 11434

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD curl -s http://localhost:11434/api/tags > /dev/null || exit 1

# Use the init script as entrypoint
ENTRYPOINT ["/bin/bash", "/scripts/init-models.sh"]
